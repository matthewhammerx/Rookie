{"sections":{"main":{"type":"main-page","blocks":{"heading":{"type":"text","name":"Title","settings":{"text":"<h1>ONE-PIECE<\/h1>","width":"100%","max_width":"normal","alignment":"center","type_preset":"h2","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["heading"],"settings":{"content_direction":"column","gap":32,"color_scheme":"scheme-5","padding-block-start":40,"padding-block-end":0}},"custom_liquid_CEcVmJ":{"type":"custom-liquid","name":"1","settings":{"custom_liquid":"<style>\n  .dual-collection-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr); \/* desktop default *\/\n    gap: 24px;\n    max-width: 900px;\n    margin: 0 auto;\n    padding: 20px 0;\n    background: transparent;\n  }\n\n  .dual-collection-item {\n    display: block;\n    margin: 0 auto;\n    position: relative;\n    animation: dualWaveFloat 4.5s ease-in-out infinite;\n    will-change: transform;\n    transition: transform .25s ease;\n  }\n\n  \/* 💜 Glow Layer *\/\n  .dual-collection-item::before {\n    content: \"\";\n    position: absolute;\n    inset: -12px;\n    border-radius: 18px;\n    background:\n      radial-gradient(circle at 30% 20%, rgba(200,0,255,.55), transparent 60%),\n      radial-gradient(circle at 70% 80%, rgba(255,0,180,.55), transparent 60%);\n    filter: blur(18px);\n    opacity: 0;\n    transition: .3s ease;\n    z-index: -1;\n  }\n\n  \/* stagger animation *\/\n  .dual-collection-item:nth-child(1) { animation-delay: 0s; }\n  .dual-collection-item:nth-child(2) { animation-delay: .35s; }\n\n  .dual-collection-item:hover {\n    animation-play-state: paused;\n    transform: translateY(-6px) scale(1.05);\n    z-index: 5;\n  }\n\n  .dual-collection-item:hover::before {\n    opacity: 1;\n    filter: blur(28px);\n  }\n\n  .dual-collection-item img {\n    width: 100%;\n    height: auto;\n    display: block;\n    box-shadow: 0 4px 14px rgba(0,0,0,.4);\n    transition: transform .2s ease, box-shadow .2s ease;\n  }\n\n  .dual-collection-item:hover img {\n    transform: translateY(-8px);\n    box-shadow: 0 12px 26px rgba(0,0,0,.6);\n  }\n\n  @keyframes dualWaveFloat {\n    0%   { transform: translateY(0px); }\n    50%  { transform: translateY(-9px); }\n    100% { transform: translateY(0px); }\n  }\n\n  \/* 📱 Mobile Stack (slightly smaller & centered) *\/\n  @media (max-width: 767px) {\n    .dual-collection-grid {\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n\n    .dual-collection-item img {\n      width: 85%;\n      margin: 0 auto;\n    }\n  }\n<\/style>\n\n<div class=\"dual-collection-grid\">\n\n  <a href=\"\/collections\/one-piece-singles\" class=\"dual-collection-item\">\n    <img loading=\"lazy\" decoding=\"async\"\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0769\/0977\/3014\/files\/Your_paragraph_text_87.png?v=1771443011\">\n  <\/a>\n\n  <a href=\"\/collections\/one-piece-sealed\" class=\"dual-collection-item\">\n    <img loading=\"lazy\" decoding=\"async\"\n      src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0769\/0977\/3014\/files\/Your_paragraph_text_85.png?v=1771442912\">\n  <\/a>\n\n<\/div>","color_scheme":"scheme-5","section_width":"page-width","padding-block-start":17,"padding-block-end":0}}},"order":["main","custom_liquid_CEcVmJ"]}