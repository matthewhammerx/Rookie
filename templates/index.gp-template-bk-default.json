    "custom_liquid_BinnqM": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "SECTION 2",
      "settings": {
        "custom_liquid": "<style>\n  .wide-collection-grid {\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 12px;\n    padding: 20px 0;\n    justify-content: center;\n    background: transparent;\n  }\n\n  .wide-collection-grid__item {\n    display: block;\n    margin: 0 auto;\n    border-radius: 0;\n    animation: waveFloat 4.5s ease-in-out infinite;\n    will-change: transform;\n    position: relative;\n  }\n\n  /* 💜 glow layer */\n  .wide-collection-grid__item::before{\n    content:\"\";\n    position:absolute;\n    inset:-12px;\n    border-radius:18px;\n    background:\n      radial-gradient(circle at 30% 20%, rgba(200,0,255,.55), transparent 60%),\n      radial-gradient(circle at 70% 80%, rgba(255,0,180,.55), transparent 60%);\n    filter: blur(18px);\n    opacity:0;\n    transition:.3s ease;\n    z-index:-1;\n  }\n\n  /* wave timing */\n  .wide-collection-grid__item:nth-child(1) { animation-delay: 0s; }\n  .wide-collection-grid__item:nth-child(2) { animation-delay: .35s; }\n  .wide-collection-grid__item:nth-child(3) { animation-delay: .7s; }\n\n  .wide-collection-grid__item:hover {\n    animation-play-state: paused;\n    transform: translateY(-6px) scale(1.05);\n    z-index:5;\n  }\n\n  /* 💜 glow ON hover */\n  .wide-collection-grid__item:hover::before{\n    opacity:1;\n    filter: blur(28px);\n    transform: scale(1.05);\n  }\n\n  .wide-collection-grid__item img {\n    width: 100%;\n    height: auto;\n    display: block;\n    border-radius: 0;\n    box-shadow: 0 4px 14px rgba(0,0,0,.4);\n    transition: transform .2s ease, box-shadow .2s ease;\n  }\n\n  .wide-collection-grid__item:hover img {\n    transform: translateY(-8px);\n    box-shadow: 0 12px 26px rgba(0,0,0,.6);\n  }\n\n  @keyframes waveFloat {\n    0%   { transform: translateY(0px); }\n    50%  { transform: translateY(-9px); }\n    100% { transform: translateY(0px); }\n  }\n\n  /* Mobile */\n  @media (max-width: 767px) {\n    .wide-collection-grid {\n      grid-template-columns: repeat(2, 1fr);\n      gap: 8px;\n      padding-top: 8px;\n      padding-bottom: 16px;\n    }\n\n    .wide-collection-grid__item img {\n      width: 100%;\n    }\n\n    .wide-collection-grid__item:nth-child(3) {\n      grid-column: 1 / -1;\n      justify-self: center;\n      max-width: 60%;\n      margin-top: 15px;\n    }\n  }\n\n  /* Desktop */\n  @media (min-width: 768px) {\n    .wide-collection-grid {\n      grid-template-columns: repeat(3, 1fr);\n      gap: 20px;\n      max-width: 1100px;\n      margin: 0 auto;\n    }\n  }\n</style>\n\n<div class=\"wide-collection-grid\">\n\n  <a href=\"/collections/etb\" class=\"wide-collection-grid__item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_68.png?v=1768260279\">\n  </a>  \n\n  <a href=\"/collections/booster-box\" class=\"wide-collection-grid__item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_69.png?v=1768260882\">\n  </a>\n\n  <a href=\"/collections/collection-box\" class=\"wide-collection-grid__item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_70.png?v=1768261506\">\n  </a>\n\n</div>",
        "color_scheme": "scheme-5",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 28
      }
