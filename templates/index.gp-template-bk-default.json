    "custom_liquid_eTXPhi": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "SECTION 1",
      "settings": {
        "custom_liquid": "<style>\n  .collection-carousel {\n    display: flex;\n    gap: 16px;\n    padding: 16px 12px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    scroll-padding: 12px;\n    -webkit-overflow-scrolling: touch;\n    touch-action: pan-x;\n    background: transparent;\n  }\n\n  .collection-carousel::-webkit-scrollbar { display: none; }\n  .collection-carousel { scrollbar-width: none; }\n\n  .collection-item {\n    flex: 0 0 auto;\n    scroll-snap-align: start;\n    scroll-snap-stop: always;\n    text-align: center;\n    animation: waveFloat 4.5s ease-in-out infinite;\n    transition: transform .25s ease;\n    position: relative;\n  }\n\n  /* 💜 glow layer */\n  .collection-item::before{\n    content:\"\";\n    position:absolute;\n    inset:-10px;\n    border-radius:20px;\n    background:\n      radial-gradient(circle at 30% 20%, rgba(200,0,255,.55), transparent 60%),\n      radial-gradient(circle at 70% 80%, rgba(255,0,180,.55), transparent 60%);\n    filter: blur(18px);\n    opacity:0;\n    transition:.3s ease;\n    z-index:-1;\n  }\n\n  /* wave timing */\n  .collection-item:nth-child(1) { animation-delay: 0s; }\n  .collection-item:nth-child(2) { animation-delay: .35s; }\n  .collection-item:nth-child(3) { animation-delay: .70s; }\n  .collection-item:nth-child(4) { animation-delay: 1.05s; }\n  .collection-item:nth-child(5) { animation-delay: 1.40s; }\n\n  .collection-item:hover {\n    animation-play-state: paused;\n    transform: translateY(-6px) scale(1.05);\n    z-index: 5;\n  }\n\n  /* 💜 glow ON hover */\n  .collection-item:hover::before{\n    opacity:1;\n    filter: blur(28px);\n    transform: scale(1.05);\n  }\n\n  .collection-item img {\n    display: block;\n    width: 140px;\n    height: auto;\n    border-radius: 0;\n    box-shadow: 0 4px 14px rgba(0,0,0,.4);\n    transition: transform .2s ease, box-shadow .2s ease;\n    will-change: transform;\n  }\n\n  .collection-item:hover img {\n    transform: translateY(-8px);\n    box-shadow: 0 12px 26px rgba(0,0,0,.6);\n  }\n\n  @keyframes waveFloat {\n    0%   { transform: translateY(0px); }\n    50%  { transform: translateY(-9px); }\n    100% { transform: translateY(0px); }\n  }\n\n  @media (min-width: 768px) {\n    .collection-carousel {\n      flex-wrap: wrap;\n      justify-content: center;\n      overflow-x: visible;\n      scroll-snap-type: none;\n    }\n\n    .collection-item { flex: 0 0 200px; }\n    .collection-item img { width: 200px; }\n  }\n</style>\n\n<div class=\"collection-carousel\">\n\n  <a href=\"/collections/slabs\" class=\"collection-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_60.png?v=1767649244\">\n  </a>\n\n  <a href=\"/collections/singles\" class=\"collection-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_62.png?v=1767650621\">\n  </a>\n\n  <a href=\"/collections/booster-pack\" class=\"collection-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_63.png?v=1767652703\">\n  </a>\n\n  <a href=\"/collections/blisters\" class=\"collection-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_65.png?v=1767653674\">\n  </a>\n\n  <a href=\"/collections/tins\" class=\"collection-item\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_64.png?v=1767653366\">\n  </a>\n\n</div>",
