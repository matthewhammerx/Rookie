    "custom_liquid_ibtitt": {
      "type": "custom-liquid",
      "name": "SECTIONS",
      "settings": {
        "custom_liquid": "<style>\n  .triple-cards {\n    width: 100%;\n    padding: 50px 14px;\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 2px; /* smaller gap */\n    justify-items: center;\n  }\n\n  /* DESKTOP */\n  @media (min-width: 768px) {\n    .triple-cards {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n      max-width: 1500px;\n      margin: 0 auto;\n      gap: 2px; /* smaller gap desktop */\n      padding: 70px 20px;\n    }\n  }\n\n  .triple-card {\n    position: relative;\n    display: block;\n    width: 100%;\n    max-width: 520px;\n    border-radius: 16px;\n    padding: 12px;\n    text-decoration: none;\n    transition: transform .25s ease;\n    animation: breathe 4.5s ease-in-out infinite;\n    will-change: transform;\n    z-index: 1;\n    overflow: visible;\n  }\n\n  /* glow */\n  .triple-card::before {\n    content: \"\";\n    position: absolute;\n    inset: -18px;\n    border-radius: 28px;\n    background:\n      radial-gradient(circle at 30% 20%, rgba(200, 0, 255, 0.6), transparent 60%),\n      radial-gradient(circle at 70% 80%, rgba(255, 0, 180, 0.6), transparent 60%);\n    filter: blur(26px);\n    opacity: .5;\n    transition: .3s ease;\n    z-index: -1;\n  }\n\n  .triple-card img{\n    width: 100%;\n    height: auto;\n    display: block;\n    border-radius: 16px;\n    box-shadow: 0 18px 50px rgba(0,0,0,.65);\n    transition: transform .35s ease;\n  }\n\n  .triple-card:hover{\n    transform: translateY(-22px) scale(1.14);\n    z-index: 20;\n    animation-play-state: paused;\n  }\n\n  .triple-card:hover img{\n    transform: scale(1.1);\n  }\n\n  .triple-card:hover::before{\n    filter: blur(42px);\n    opacity: 1;\n    transform: scale(1.12);\n  }\n\n  @keyframes breathe{\n    0%   { transform: translateY(0px) scale(1); }\n    50%  { transform: translateY(-8px) scale(1.01); }\n    100% { transform: translateY(0px) scale(1); }\n  }\n\n  /* MOBILE BIG */\n  @media (max-width: 767px){\n    .triple-cards{\n      padding: 24px 6px !important;\n      gap: 4px; /* smaller mobile gap */\n    }\n\n    .triple-card{\n      width: 100% !important;\n      max-width: 100% !important;\n      padding: 6px !important;\n    }\n\n    .triple-card img{\n      width: 100% !important;\n      max-width: 100% !important;\n    }\n\n    .triple-card:hover{\n      transform: translateY(-14px) scale(1.08);\n    }\n\n    .triple-card:hover img{\n      transform: scale(1.06);\n    }\n  }\n</style>\n\n<div class=\"triple-cards\">\n  <a href=\"/pages/pokemon-collection\" class=\"triple-card\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_25_27d18e73-e051-47d1-ba35-9cf5ef5e4a31.png?v=1771298069\">\n  </a>\n\n  <a href=\"/pages/accessories\" class=\"triple-card\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_28.png?v=1771301731\">\n  </a>\n\n  <a href=\"/pages/one-piece-collection\" class=\"triple-card\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_26.png?v=1771298070\">\n  </a>\n</div>",
