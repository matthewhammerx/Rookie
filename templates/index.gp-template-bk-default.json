    "custom_liquid_BTpFNC": {
      "type": "custom-liquid",
      "name": "SECTION 3",
      "settings": {
        "custom_liquid": "<div id=\"collection-grid-8\">\n  <style>\n    /* ===== GRID LAYOUT ===== */\n    #collection-grid-8 {\n      width: 100%;\n    }\n\n    #collection-grid-8 .collection-grid {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr); /* Mobile */\n      gap: 10px;\n      padding: 20px 8px;\n      width: 100%;\n      margin: 0 auto;\n    }\n\n    /* Desktop 4 x 2 */\n    @media (min-width: 768px) {\n      #collection-grid-8 .collection-grid {\n        grid-template-columns: repeat(4, 1fr);\n        gap: 8px;              /* VERY tight */\n        padding: 30px 20px;\n      }\n    }\n\n    /* ===== ITEM ===== */\n    #collection-grid-8 .collection-item {\n      position: relative;\n      animation: waveFloat_grid8 4.5s ease-in-out infinite;\n      transition: transform .25s ease;\n    }\n\n    /* Glow */\n    #collection-grid-8 .collection-item::before {\n      content:\"\";\n      position:absolute;\n      inset:-8px;\n      border-radius:18px;\n      background:\n        radial-gradient(circle at 30% 20%, rgba(200,0,255,.55), transparent 60%),\n        radial-gradient(circle at 70% 80%, rgba(255,0,180,.55), transparent 60%);\n      filter: blur(18px);\n      opacity:0;\n      transition:.3s ease;\n      z-index:-1;\n    }\n\n    #collection-grid-8 .collection-item:hover {\n      animation-play-state: paused;\n      transform: translateY(-6px) scale(1.05);\n      z-index:5;\n    }\n\n    #collection-grid-8 .collection-item:hover::before {\n      opacity:1;\n      filter: blur(26px);\n    }\n\n    #collection-grid-8 .collection-item img {\n      width: 100%;           /* FULL column width */\n      height: auto;\n      display: block;\n      box-shadow: 0 4px 14px rgba(0,0,0,.4);\n      transition: transform .2s ease, box-shadow .2s ease;\n    }\n\n    #collection-grid-8 .collection-item:hover img {\n      transform: translateY(-8px);\n      box-shadow: 0 12px 26px rgba(0,0,0,.6);\n    }\n\n    @keyframes waveFloat_grid8 {\n      0%   { transform: translateY(0px); }\n      50%  { transform: translateY(-9px); }\n      100% { transform: translateY(0px); }\n    }\n  </style>\n\n  <div class=\"collection-grid\">\n\n    <a href=\"/collections/slabs\" class=\"collection-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_91.png?v=1771515202\">\n    </a>\n\n    <a href=\"/collections/singles\" class=\"collection-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_92.png?v=1771516926\">\n    </a>\n\n    <a href=\"/collections/booster-pack\" class=\"collection-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_95.png?v=1771526058\">\n    </a>\n\n    <a href=\"/collections/blisters\" class=\"collection-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_99.png?v=1771594333\">\n    </a>\n\n    <a href=\"/collections/tins\" class=\"collection-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_-_2026-02-20T085236.316.png?v=1771595622\">\n    </a>\n\n    <a href=\"/collections/etb\" class=\"collection-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_88.png?v=1771514073\">\n    </a>\n\n    <a href=\"/collections/booster-box\" class=\"collection-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_-_2026-02-20T100742.596.png?v=1771600087\">\n    </a>\n\n    <a href=\"/collections/collection-box\" class=\"collection-item\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0769/0977/3014/files/Your_paragraph_text_96.png?v=1771592167\">\n    </a>\n\n  </div>\n</div>",
