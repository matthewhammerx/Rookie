<div class="collection-tile-grid-{{ section.id }} collection-tile-grid">
  <div class="collection-tile-grid__inner">
    {% for block in section.blocks %}
      <a
        href="{{ block.settings.link | default: '#' }}"
        class="collection-item"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.image %}
          {{
            block.settings.image
            | image_url: width: 900
            | image_tag:
              widths: '300, 450, 600, 900',
              sizes: '(min-width: 768px) 25vw, 50vw',
              alt: block.settings.label | default: block.settings.image.alt,
              loading: 'lazy'
          }}
        {% endif %}
      </a>
    {% endfor %}
  </div>
</div>

<style>
  .collection-tile-grid-{{ section.id }} {
    width: 100%;
    background: #000;
  }

  .collection-tile-grid-{{ section.id }} .collection-tile-grid__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    padding: 20px 8px;
    width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .collection-tile-grid-{{ section.id }} .collection-tile-grid__inner {
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      padding: 30px 20px;
    }
  }

  .collection-tile-grid-{{ section.id }} .collection-item {
    --spot-x: 50%;
    --spot-y: 50%;
    position: relative;
    display: block;
    animation: collectionTileFloat-{{ section.id }} 4.5s ease-in-out infinite;
    transition: transform 0.25s ease;
  }

  .collection-tile-grid-{{ section.id }} .collection-item::before {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 18px;
    background: radial-gradient(circle at var(--spot-x) var(--spot-y), rgba(200, 0, 255, 0.6), transparent 55%),
      radial-gradient(circle at var(--spot-x) var(--spot-y), rgba(255, 0, 180, 0.4), transparent 70%);
    filter: blur(18px);
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: -1;
    pointer-events: none;
  }

  .collection-tile-grid-{{ section.id }} .collection-item:hover,
  .collection-tile-grid-{{ section.id }} .collection-item.is-active {
    animation-play-state: paused;
    transform: translateY(-6px) scale(1.05);
    z-index: 5;
  }

  .collection-tile-grid-{{ section.id }} .collection-item:hover::before,
  .collection-tile-grid-{{ section.id }} .collection-item.is-active::before {
    opacity: 1;
    filter: blur(26px);
  }

  .collection-tile-grid-{{ section.id }} .collection-item img {
    width: 100%;
    height: auto;
    display: block;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .collection-tile-grid-{{ section.id }} .collection-item:hover img,
  .collection-tile-grid-{{ section.id }} .collection-item.is-active img {
    transform: translateY(-8px);
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-tile-grid-{{ section.id }} .collection-item {
      animation: none;
    }
  }

  @keyframes collectionTileFloat-{{ section.id }} {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-9px);
    }
  }
</style>

<script>
  (function () {
    var rootSelector = '.collection-tile-grid-{{ section.id }}';

    function pointerPercent(el, clientX, clientY) {
      var rect = el.getBoundingClientRect();
      var x = ((clientX - rect.left) / rect.width) * 100;
      var y = ((clientY - rect.top) / rect.height) * 100;
      return {
        x: Math.max(0, Math.min(100, x)),
        y: Math.max(0, Math.min(100, y)),
      };
    }

    function setSpot(el, clientX, clientY) {
      var pos = pointerPercent(el, clientX, clientY);
      el.style.setProperty('--spot-x', pos.x + '%');
      el.style.setProperty('--spot-y', pos.y + '%');
    }

    function init() {
      var root = document.querySelector(rootSelector);
      if (!root) return;
      var tiles = root.querySelectorAll('.collection-item');
      tiles.forEach(function (tile) {
        if (tile.dataset.glowBound) return;
        tile.dataset.glowBound = 'true';

        tile.addEventListener('pointermove', function (e) {
          setSpot(tile, e.clientX, e.clientY);
        });
        tile.addEventListener('pointerdown', function (e) {
          setSpot(tile, e.clientX, e.clientY);
          tile.classList.add('is-active');
        });
        tile.addEventListener('pointerup', function () {
          tile.classList.remove('is-active');
        });
        tile.addEventListener('pointerleave', function () {
          tile.classList.remove('is-active');
        });
        tile.addEventListener('pointercancel', function () {
          tile.classList.remove('is-active');
        });
      });
    }

    init();
    document.addEventListener('shopify:section:load', init);
  })();
</script>

