    {
      "type": "range",
      "id": "spotlight_grayscale_mobile",
      "label": "Other tiles grayscale (mobile)",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "default": 60
    }
  ],
  "blocks": [
    {
