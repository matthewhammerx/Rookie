<style>
  /* ===== CUSTOM MARQUEE (BOLD FIXED) ===== */
  .section-{{ section.id }}.custom-marquee {
    display: flex;
    align-items: center;
    height: {{ section.settings.marquee_height }}px;
    width: 100%;
    overflow: hidden;
    background: {{ section.settings.colorBackground }};
    color: {{ section.settings.colorText }};
    border-top: 2px solid #000;
    border-bottom: 2px solid #000;

    /* FORCE A FONT THAT SUPPORTS BOLD */
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 
  }

  .section-{{ section.id }}.custom-marquee a {
    color: inherit;
    text-decoration: none;
    width: 100%;
  }

  .section-{{ section.id }} .track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
    animation: marquee-scroll {{ section.settings.speed }}s linear infinite;
  }

  .section-{{ section.id }} .item {
    display: inline-flex;
    align-items: center;
    margin-right: 40px;
    font-size: {{ section.settings.font_size }}px;

    /* 🔥 REAL BOLD */
    font-weight: 600 !important;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .section-{{ section.id }} svg {
    fill: {{ section.settings.colorText }};
    margin-right: 8px;
  }

  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .track {
      animation: none;
    }
  }
</style>

<div class="section-{{ section.id }} custom-marquee" role="region">
  {% if section.settings.link != blank %}
    <a href="{{ section.settings.link }}">
  {% endif %}

    <div class="track">
      {% for block in section.blocks %}
        <span class="item">
          {% if block.settings.icon != 'none' %}
            {% render 'icon-accordion', icon: block.settings.icon %}
          {% endif %}
          {{ block.settings.text | escape }}
        </span>
      {% endfor %}

      {% for block in section.blocks %}
        <span class="item">
          {% if block.settings.icon != 'none' %}
            {% render 'icon-accordion', icon: block.settings.icon %}
          {% endif %}
          {{ block.settings.text | escape }}
        </span>
      {% endfor %}
    </div>

  {% if section.settings.link != blank %}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Custom Marquee (Bold)",
  "settings": [
    {
      "type": "color",
      "id": "colorBackground",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "colorText",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Optional link"
    },
    {
      "type": "range",
      "id": "marquee_height",
      "label": "Marquee height",
      "min": 30,
      "max": 120,
      "step": 2,
      "default": 46
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 18
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds)",
      "min": 5,
      "max": 40,
      "step": 1,
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "FREE SHIPPING ON ALL ORDERS"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "check_mark",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Truck" },
            { "value": "fire", "label": "Fire" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Marquee (Bold)",
      "blocks": [
        { "type": "text" },
        { "type": "text" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
