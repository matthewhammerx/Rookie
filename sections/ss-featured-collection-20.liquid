              gap: 5px;
              align-items: center;
            }

            .countdown-{{ block.id }} .tick-flip {
              margin: 0;
              font-size: {{ block.settings.number_size_mobile }}px !important;
              color: {{ block.settings.number_color }};
              line-height: {{ block.settings.number_height }}%;
