              }

              .countdown-{{ block.id }} .tick-flip-panel {
                padding: 0px 15px;
                background-color: {{ block.settings.card_bg_color }};
              }
            }
          </style>
          {% if block.settings.number_custom %}
            <style>
              .countdown-{{ block.id }} .tick-flip {
                font-family: {{ block.settings.number_font.family }}, {{ block.settings.number_font.fallback_families }};
                font-weight: {{ block.settings.number_font.weight }};
                font-style: {{ block.settings.number_font.style }};
              }
            </style>
          {% endif %}

          {% if block.settings.text_custom %}
            <style>
              .countdown-{{ block.id }} .tick-label.tick-text {
                font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
                font-weight: {{ block.settings.text_font.weight }};
                font-style: {{ block.settings.text_font.style }};
              }
            </style>
          {% endif %}

          {% if block.settings.completed_text_custom %}
            <style>
              .countdown-completed-text-{{ block.id }} * {
                font-family: {{ block.settings.completed_text_font.family }}, {{ block.settings.completed_text_font.fallback_families }};
                font-weight: {{ block.settings.completed_text_font.weight }};
                font-style: {{ block.settings.completed_text_font.style }};
              }
            </style>
          {% endif %}

          {% if block.settings.wrapper_align_mobile == 'center' %}
            <style>
              .countdown-wrapper-{{ block.id }} {
                align-items: center;
              }
            </style>
          {% elsif block.settings.wrapper_align_mobile == 'left' %}
            <style>
              .countdown-wrapper-{{ block.id }} {
                align-items: start;
              }
            </style>
          {% else %}
            <style>
              .countdown-wrapper-{{ block.id }} {
                align-items: end;
              }
            </style>
          {% endif %}

          {% if block.settings.wrapper_align == 'center' %}
            <style>
              @media (min-width: 1024px) {
                .countdown-wrapper-{{ block.id }} {
                  align-items: center;
                }
              }
            </style>
          {% elsif block.settings.wrapper_align == 'left' %}
            <style>
              @media (min-width: 1024px) {
                .countdown-wrapper-{{ block.id }} {
                  align-items: start;
                }
              }
            </style>
          {% else %}
            <style>
              @media (min-width: 1024px) {
                .countdown-wrapper-{{ block.id }} {
                  align-items: end;
                }
              }
            </style>
          {% endif %}

        {% else %}

          <style>
            {{  block.settings.number_font | font_face: font_display: 'swap' }}
            {{  block.settings.text_font | font_face: font_display: 'swap' }}
            {{  block.settings.completed_text_font | font_face: font_display: 'swap' }}

            .countdown-timer-{{ block.id }} {
              margin-top: {{ block.settings.timer_mt_mobile }}px;
              display: flex;
              align-items: stretch;
              width: 100%;
              gap: {{ block.settings.timer_gap_mobile }}px;
              justify-content: {{ content_horizontal_align_mobile }};
            }

            .countdown-timer-{{ block.id }} .time-block {
              display: flex;
              flex-direction: column;
              align-items: center;
              justify-content: center;
              text-align: center;
              flex: 0 1 {{ block.settings.card_width_mobile }}px;
              gap: 8px;
              background-color: {{ block.settings.card_bg_color }};
              border-radius: {{ block.settings.card_radius }}px;
              padding: {{ block.settings.card_padding_vertical_mobile }}px {{ block.settings.card_padding_horizontal_mobile }}px;
            }

            .countdown-timer-{{ block.id }} .time-block__num {
              margin: 0;
              font-size: {{ block.settings.number_size_mobile }}px !important;
              color: {{ block.settings.number_color }};
              line-height: {{ block.settings.number_height }}%;
              text-transform: unset;
              font-weight: 700;
            }

            .countdown-timer-{{ block.id }} .time-block__unit {
              margin: 0;
              font-size: {{ block.settings.text_size_mobile }}px;
              color: {{ block.settings.text_color }};
              line-height: {{ block.settings.text_height }}%;
              word-break: break-word;
              text-transform: unset;
            }

            .countdown-timer-completed-text-{{ block.id }} {
              margin-top: {{ block.settings.completed_text_mt_mobile }}px;
            }

            .countdown-timer-completed-text-{{ block.id }} * {
              margin: 0;
              font-size: {{ block.settings.completed_text_size_mobile }}px;
              color: {{ block.settings.completed_text_color }};
              line-height: {{ block.settings.completed_text_height }}%;
              text-transform: unset;
            }

            @media(min-width: 1024px) {
              .countdown-timer-{{ block.id }} {
                margin-top: {{ block.settings.timer_mt }}px;
                gap: {{ block.settings.timer_gap }}px;
                justify-content: {{ content_horizontal_align }};
              }

              .countdown-timer-{{ block.id }} .time-block {
                flex: 0 1 {{ block.settings.card_width }}px;
                padding: {{ block.settings.card_padding_vertical }}px {{ block.settings.card_padding_horizontal }}px;
              }

              .countdown-timer-{{ block.id }} .time-block__num {
                font-size: {{ block.settings.number_size }}px !important;
              }

              .countdown-timer-{{ block.id }} .time-block__unit {
                font-size: {{ block.settings.text_size }}px;
              }

              .countdown-timer-completed-text-{{ block.id }} {
                margin-top: {{ block.settings.completed_text_mt }}px;
              }

              .countdown-timer-completed-text-{{ block.id }} * {
                font-size: {{ block.settings.completed_text_size }}px;
              }
            }
          </style>

          {% if block.settings.number_custom %}
            <style>
              .countdown-timer-{{ block.id }} .time-block__num {
                font-family: {{ block.settings.number_font.family }}, {{ block.settings.number_font.fallback_families }};
                font-weight: {{ block.settings.number_font.weight }};
                font-style: {{ block.settings.number_font.style }};
              }
            </style>
          {% endif %}

          {% if block.settings.text_custom %}
            <style>
              .countdown-timer-{{ block.id }} .time-block__unit {
                font-family: {{ block.settings.text_font.family }}, {{ block.settings.text_font.fallback_families }};
                font-weight: {{ block.settings.text_font.weight }};
                font-style: {{ block.settings.text_font.style }};
              }
            </style>
          {% endif %}

          {% if block.settings.completed_text_custom %}
            <style>
              .countdown-timer-completed-text-{{ block.id }} * {
                font-family: {{ block.settings.completed_text_font.family }}, {{ block.settings.completed_text_font.fallback_families }};
                font-weight: {{ block.settings.completed_text_font.weight }};
                font-style: {{ block.settings.completed_text_font.style }};
              }
            </style>
          {% endif %}

        {% endif %}

    {% when 'button' %}
      <style>
        {{  block.settings.button_font | font_face: font_display: 'swap' }}

        .featured-button-{{ block.id }} {
          display: inline-flex;
          position: relative;
          overflow: hidden;
          align-items: center;
          justify-content: center;
          max-width: fit-content;
          gap: 10px;
          width: 100%;
          margin: 0;
          margin-top: {{ block.settings.button_mt_mobile }}px;
          font-size: {{ block.settings.button_size_mobile }}px;
          color: {{ block.settings.button_color }};
          line-height: {{ block.settings.button_height }}%;
          text-align: center;
          text-transform: unset;
          text-decoration: none;
          padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
          border-radius: {{ block.settings.button_radius }}px;
          transition: all 0.3s ease 0s;
          background-color: transparent;
          border: 0px;
          cursor: pointer;
          font-weight: 700;
        }

        .featured-button-inner-{{ block.id }} {
          margin: 0px;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 10px;
          text-decoration: none;
        }

        .featured-button-{{ block.id }}:hover {
          color: {{ block.settings.button_hover_color }};
          transition: all 0.25s ease 0s;
        }

        .featured-button-{{ block.id }} svg {
          width: 14px;
          height: 14px;
        }

        .featured-button-{{ block.id }} svg path {
          fill: {{ block.settings.button_color }};
          transition: all 0.25s ease 0s;
        }

        .featured-button-{{ block.id }}:hover svg path {
          fill: {{ block.settings.button_hover_color }};
          transition: all 0.25s ease 0s;
        }

        @media (min-width: 1024px) {
          .featured-button-{{ block.id }} {
            margin-top: {{ block.settings.button_mt }}px;
            padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
            font-size: {{ block.settings.button_size }}px;
          }
        }
      </style>

      {% if block.settings.button_custom %}
        <style>
          .featured-button-{{ block.id }} {
            font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
            font-weight: {{ block.settings.button_font.weight }};
            font-style: {{ block.settings.button_font.style }};
          }
        </style>
      {% endif %}

      {% if block.settings.button_style == "non_outline" or block.settings.button_style == "non_outline_arrow" %}
        <style>
          .featured-button-{{ block.id }} {
            transition: all 0.3s ease 0s;
            background-color: {{  block.settings.button_bg_color }};
          }

          .featured-button-{{ block.id }}:hover {
            transition: all 0.3s ease 0s;
            background-color: {{  block.settings.button_bg_hover_color }};
          }
        </style>
      {% elsif block.settings.button_style == "outline" or block.settings.button_style == "outline_arrow" %}
        <style>
          .featured-button-{{ block.id }} {
            transition: all 0.3s ease 0s;
            background-color: {{  block.settings.button_bg_color }};
            border: {{  block.settings.button_border_thickness }}px solid {{  block.settings.button_border_color }};
          }

          .featured-button-{{ block.id }}:hover {
            transition: all 0.3s ease 0s;
            background-color: {{  block.settings.button_bg_hover_color }};
            border: {{  block.settings.button_border_thickness }}px solid {{ block.settings. button_border_hover_color }};
          }
        </style>
      {% elsif block.settings.button_style == "link" %}
        <style>
          .featured-button-{{ block.id }} {
            padding: 0px !important;
            -webkit-box-shadow: none !important;
            -moz-box-shadow: none !important;
            box-shadow: none !important;
          }
        </style>
      {% endif %}

      {% if block.settings.button_golden %}
        <style>
          .featured-button-{{ block.id }} {
            background: linear-gradient(
              135deg,
              #8a611c 0%,
              #d1971f 14%,
              #f7c948 30%,
              #ffe066 48%,
              #f7c948 66%,
              #d1971f 84%,
              #8a611c 100%
            ) !important;
            background-size: 260% 260% !important;
            animation: featuredButtonGoldShine{{ block.id | replace: '-', '' }} 3.5s ease infinite;
            border: 2px solid #7a4e14 !important;
            color: #4a2c06 !important;
            text-shadow: 0 1px 0 rgba(255, 255, 255, 0.5);
            box-shadow:
              inset 0 1px 0 rgba(255, 255, 255, 0.75),
              inset 0 -3px 5px rgba(90, 58, 12, 0.4),
              0 3px 10px rgba(122, 78, 20, 0.45) !important;
          }

          .featured-button-{{ block.id }}::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(255, 255, 255, 0.65) 0%, rgba(255, 255, 255, 0) 55%);
            border-radius: inherit;
            pointer-events: none;
            z-index: 0;
          }

          .featured-button-inner-{{ block.id }} {
            position: relative;
            z-index: 2;
          }

          .featured-button-{{ block.id }}:hover {
            background-position: 100% 0% !important;
            border-color: #5c3b0f !important;
            color: #341f04 !important;
          }

          .featured-button-{{ block.id }} svg path {
            fill: #4a2c06 !important;
          }

          .featured-button-{{ block.id }}:hover svg path {
            fill: #341f04 !important;
          }

          @keyframes featuredButtonGoldShine{{ block.id | replace: '-', '' }} {
            0% {
              background-position: 0% 50%;
            }
            50% {
              background-position: 100% 50%;
            }
            100% {
              background-position: 0% 50%;
            }
          }
        </style>
      {% endif %}

      {% if block.settings.button_sparkles %}
        <style>
          .featured-button-sparkle-{{ block.id }} {
            position: absolute;
            pointer-events: none;
            background: {{ block.settings.button_sparkle_color }};
            clip-path: polygon(50% 0%, 61% 35%, 100% 50%, 61% 65%, 50% 100%, 39% 65%, 0% 50%, 39% 35%);
            opacity: 0;
            z-index: 3;
            animation: featuredButtonSparkle{{ block.id | replace: '-', '' }} 1.1s ease-in-out forwards;
          }

          @keyframes featuredButtonSparkle{{ block.id | replace: '-', '' }} {
            0% {
              transform: scale(0) rotate(0deg);
              opacity: 0;
            }
            50% {
              transform: scale(1) rotate(90deg);
              opacity: 1;
            }
            100% {
              transform: scale(0) rotate(180deg);
              opacity: 0;
            }
          }
        </style>
      {% endif %}
  {% endcase %}
{% endfor %}

{% capture first_list %}
  <div class="featured-scrolling-list-{{ section.id }}">
    {% for item in (1..5) %}
      {% for block in section.blocks %}
        {% if block.type == 'card' or block.type == 'custom_card' %}
          {% if block.settings.row == 'first_row' %}
            <div class="featured-card-{{ section.id }}{% if block.type == 'custom_card' and block.settings.transparent_bg %} featured-card-transparent{% endif %}">
              <div class="featured-card-image-{{ section.id }}">
                {% if block.type == 'custom_card' %}
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | escape }}" {% if lazy %}loading="lazy"{% endif %}>
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                {% else %}
                  {% if block.settings.product.featured_image != blank %}
                    <img src="{{ block.settings.product.featured_image | img_url: "500x500" }}" alt="{{ block.settings.product.featured_image.alt }}" {% if lazy %}loading="lazy"{% endif %}>
                  {% else %}
                    {{ 'image' | placeholder_svg_tag }}
                  {% endif %}
                {% endif %}
              </div>
              <div class="featured-card-content-{{ section.id }}">
                {% if block.type == 'custom_card' %}
                  {% if block.settings.title != blank %}
                    <h3 class="featured-card-title-{{ section.id }}">{{ block.settings.title }}</h3>
                  {% endif %}
