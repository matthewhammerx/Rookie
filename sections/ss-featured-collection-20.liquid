{% for block in section.blocks %}
  {% if block.type == "timer" %}
    {% if block.settings.timer_style == 'flip_card' %}
    <script src="https://cdn.jsdelivr.net/npm/@pqina/flip@latest/dist/flip.min.js"></script>

    <script>
      function handleTickInit_{{ block.id }}(tick) {

    function debounce(func, delay) {
    let timeout;
    return function(...args) {
    const context = this;
    clearTimeout(timeout);
    timeout = setTimeout(() => func.apply(context, args), delay);
    };
    }

    const endDateString = `{{ block.settings.year }}/{{ block.settings.month }}/{{ block.settings.day }} {{ block.settings.hour }}:{{ block.settings.minute }}:00`;
    const endDate = new Date(endDateString);

    const completedMessageElement = document.querySelector('.countdown-completed-text-{{ block.id }}');
    const timerWrapperElement = tick.root;

    function setTickFlipWidth() {
    const tickFlipElements = document.querySelectorAll('.countdown-numbers-{{ block.id }} .tick-flip');
    let maxWidth = 0;

    tickFlipElements.forEach(el => {
    el.style.width = ''; // Сброс ширины
    const currentWidth = el.offsetWidth;
    if (currentWidth > maxWidth) maxWidth = currentWidth;
    });

    if (maxWidth) {
    tickFlipElements.forEach(el => el.style.width = `${maxWidth}px`);
    }
    }

    const debouncedSetTickFlipWidth = debounce(setTickFlipWidth, 250);
    setTimeout(debouncedSetTickFlipWidth, 50);

    window.addEventListener('resize', debouncedSetTickFlipWidth);

        const customLabels = {
          d: "{{ block.settings.days_text }}",
          h: "{{ block.settings.hours_text }}",
          m: "{{ block.settings.minutes_text }}",
          s: "{{ block.settings.seconds_text }}"
        };

        function overrideLabels() {
          const labelElements = tick.root.querySelectorAll('[data-key="label"]');
          const keys = ['d', 'h', 'm', 's'];

          labelElements.forEach((el, index) => {
            const key = keys[index];
            if (el && customLabels[key]) {
              el.textContent = customLabels[key];
              el.classList.add('custom-tick-label');
            }
          });
        }


    const counter = Tick.count.down(endDate, {
    format: ['d', 'h', 'm', 's']
    });

        setTimeout(overrideLabels, 100);


    counter.onupdate = function(value) {
    tick.value = value;

    if (tick.root) {
    tick.root.setAttribute('aria-label',
    `Осталось: ${value.days} дней, ${value.hours} часов, ${value.minutes} минут, ${value.seconds} секунд`);
    }

          overrideLabels();

    };

    counter.onended = function() {
    {% if block.settings.hide_timer_on_completed %}
    if (timerWrapperElement) {
    timerWrapperElement.style.display = 'none';
    }
    if (completedMessageElement) {
    completedMessageElement.style.display = 'block';
    }
    {% else %}
    tick.value = { days: 0, hours: 0, minutes: 0, seconds: 0 };
    if (completedMessageElement) {
    completedMessageElement.style.display = 'block';
    }
    {% endif %}
    };

        setTimeout(overrideLabels, 500);
    }

      if (window.Shopify && Shopify.designMode) {
        document.addEventListener('shopify:section:load', function(event) {
          if (event.detail.sectionId === '{{ section.id }}') {
            const tickElements = event.detail.section.querySelectorAll('.tick-{{ block.id }}');
            tickElements.forEach(tickElement => {
              if (tickElement.Tick) {
                tickElement.Tick.unmount();
              }
              Tick.mount(tickElement);
            });
          }
        });

        document.addEventListener('shopify:section:unload', function(event) {
          if (event.detail.sectionId === '{{ section.id }}') {
            const tickElements = event.detail.section.querySelectorAll('.tick-{{ block.id }}');
            tickElements.forEach(tickElement => {
              if (tickElement.Tick) {
                tickElement.Tick.unmount();
              }
            });
          }
        });
      }
    </script>
    {% else %}
      <script>
        function initFeaturedCollection20() {
          function startTimer() {
            const second = 1000,
              minute = second * 60,
              hour = minute * 60,
              day = hour * 24,
              wrapper = document.querySelector(
                '.countdown-timer-{{ block.id }}'
              ),
              countDown = new Date('{{  block.settings.year }}-{{  block.settings.month }}-{{  block.settings.day }}T{{  block.settings.hour }}:{{  block.settings.minute }}:00Z').getTime();

            console.log('start timer, end date:' + countDown)
            const interval = setInterval(function () {
              let now = new Date().getTime(),
                distance = countDown - now,
                days = Math.floor(distance / day),
                hours = Math.floor((distance % day) / hour),
                minutes = Math.floor((distance % hour) / minute),
                seconds = Math.floor((distance % minute) / second);

              // Hide or show days time-block based on value
              const daysBlock = wrapper.querySelector('.js-timer-days').closest('.time-block');
              if (daysBlock) {
                daysBlock.style.display = days <= 0 ? 'none' : '';
              }

              (wrapper.querySelector('.js-timer-days').innerText = (
                days
              )),
                (wrapper.querySelector('.js-timer-hours').innerText = (
                  hours
                )),
                (wrapper.querySelector('.js-timer-minutes').innerText = (
                  minutes
                )),
                (wrapper.querySelector('.js-timer-seconds').innerText = (
                  seconds
                ));

              if (distance < 0) {
                wrapper.querySelector('.js-timer-days').innerText = '00';
                wrapper.querySelector('.js-timer-hours').innerText = '00';
                wrapper.querySelector('.js-timer-minutes').innerText = '00';
                wrapper.querySelector('.js-timer-seconds').innerText = '00';
                {% if block.settings.hide_timer_on_completed %}
                  wrapper.style.display = 'none';
                {% endif %}
                document.querySelector(
                  '.countdown-timer-completed-text-{{ block.id }}'
                ).style.display = 'block';

                clearInterval(interval);
              }

            }, second);
            document.addEventListener('shopify:section:unload', function (event) {
              if (event.detail.sectionId === '{{ section.id }}') clearInterval(interval);
            });
          }
          startTimer()
          if (window.Shopify && Shopify.designMode) {
            document.addEventListener('shopify:section:load', function (event) {
              if (event.detail.sectionId === '{{ section.id }}') {
                startTimer();
              }
            });
          }
        }

        document.addEventListener('DOMContentLoaded', initFeaturedCollection20);

        if (Shopify.designMode) {
          document.addEventListener('shopify:section:unload', initFeaturedCollection20);
          document.addEventListener('shopify:section:load', initFeaturedCollection20);
        }
      </script>
    {% endif %}
  {% endif %}
{% endfor %}

{% for block in section.blocks %}
  {% if block.type == 'button' and block.settings.button_sparkles %}
    <script>
      (function() {
        function initButtonSparkles_{{ block.id }}() {
          var btn = document.querySelector('.featured-button-{{ block.id }}');
          if (!btn || btn.dataset.sparklesInit === 'true') return;
          btn.dataset.sparklesInit = 'true';

          function spawnSparkle() {
            if (!document.body.contains(btn)) return;

            var sparkle = document.createElement('span');
            sparkle.className = 'featured-button-sparkle-{{ block.id }}';
            var size = Math.random() * 7 + 5;
            sparkle.style.width = size + 'px';
            sparkle.style.height = size + 'px';
            sparkle.style.left = (Math.random() * 66 + 17) + '%';
            sparkle.style.top = (Math.random() * 60 + 20) + '%';
            btn.appendChild(sparkle);

            sparkle.addEventListener('animationend', function() {
              sparkle.remove();
            });

            setTimeout(spawnSparkle, Math.random() * 900 + 300);
          }

          spawnSparkle();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initButtonSparkles_{{ block.id }});
        } else {
          initButtonSparkles_{{ block.id }}();
        }

        if (window.Shopify && Shopify.designMode) {
          document.addEventListener('shopify:section:load', function(event) {
            if (event.detail.sectionId === '{{ section.id }}') {
              var btn = document.querySelector('.featured-button-{{ block.id }}');
              if (btn) btn.dataset.sparklesInit = '';
              initButtonSparkles_{{ block.id }}();
            }
          });
        }
      })();
    </script>
  {% endif %}
{% endfor %}

{% if background_style == 'video' and background_video != blank %}
  <script>
    (function () {
      function initLazyVideo_{{ section.id }}() {
        var video = document.querySelector('.section-{{ section.id }} [data-lazy-video]');
        if (!video || video.dataset.lazyBound === 'true') return;
        video.dataset.lazyBound = 'true';

        var playVideo = function () {
          video.play().catch(function () {});
        };

        if ('IntersectionObserver' in window) {
          var observer = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                  playVideo();
                  observer.unobserve(video);
                }
              });
            },
            { rootMargin: '600px 0px' }
          );
          observer.observe(video);
        } else {
          playVideo();
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLazyVideo_{{ section.id }});
      } else {
        initLazyVideo_{{ section.id }}();
      }

      if (window.Shopify && Shopify.designMode) {
        document.addEventListener('shopify:section:load', function (event) {
          if (event.detail.sectionId === '{{ section.id }}') {
            var video = document.querySelector('.section-{{ section.id }} [data-lazy-video]');
            if (video) video.dataset.lazyBound = '';
            initLazyVideo_{{ section.id }}();
          }
        });
      }
    })();
  </script>
{% endif %}

