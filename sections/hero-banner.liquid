      transition: none;
    }

    .hero-banner-{{ section.id }} .hero-banner-button:hover {
      transform: none;
    }

    .hero-banner-{{ section.id }} .hero-banner__heading-line--shine {
      animation: none !important;
    }
  }
</style>

<script>
  (function () {
    var rootSelector = '.hero-banner-{{ section.id }}';

    function initCountdown(root) {
      var el = root.querySelector('[data-countdown]');
      if (!el || el.dataset.countdownBound) return;
      el.dataset.countdownBound = 'true';

      var endTime = new Date(el.dataset.end).getTime();
      var hideOnComplete = el.dataset.hideOnComplete === 'true';
      var completeEl = root.querySelector('[data-countdown-complete]');
      var daysItem = el.querySelector('[data-unit="days"]');
      var timerId = null;

      function setUnit(unit, value) {
        var item = el.querySelector('[data-unit="' + unit + '"] [data-value]');
        if (item) item.textContent = String(value).padStart(2, '0');
      }

      function tick() {
        var diff = endTime - Date.now();

        if (diff <= 0) {
          clearInterval(timerId);
          if (hideOnComplete) {
            el.hidden = true;
          } else {
            el.querySelectorAll('[data-value]').forEach(function (n) {
              n.textContent = '00';
            });
          }
          if (completeEl) completeEl.hidden = false;
          return;
        }

        var day = 86400000;
        var hour = 3600000;
        var minute = 60000;
        var days = Math.floor(diff / day);
        var hours = Math.floor((diff % day) / hour);
        var minutes = Math.floor((diff % hour) / minute);
        var seconds = Math.floor((diff % minute) / 1000);

        if (daysItem) {
          var showDays = days > 0;
          daysItem.hidden = !showDays;
          if (daysItem.nextElementSibling) daysItem.nextElementSibling.hidden = !showDays;
        }

        setUnit('days', days);
        setUnit('hours', hours);
        setUnit('minutes', minutes);
        setUnit('seconds', seconds);
      }

      tick();
      timerId = setInterval(tick, 1000);

      document.addEventListener('shopify:section:unload', function (e) {
        if (e.detail.sectionId === '{{ section.id }}') clearInterval(timerId);
      });
    }

    function init() {
      var root = document.querySelector(rootSelector);
      if (!root) return;
      initCountdown(root);
    }

    init();
    document.addEventListener('shopify:section:load', init);
  })();
</script>

