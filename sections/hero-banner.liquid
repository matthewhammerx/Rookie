{% comment %}
  Hero Banner
  A full-bleed hero (no rounded card, no side margins) that fills the
  full width of the page and fades seamlessly into whatever comes after
  it, instead of ending in a hard rectangular edge. Background can be a
  video, image, gradient or solid color. Built for reuse across pages --
  homepage, collection pages, custom pages -- with a heading, optional
  subheading, and any number of buttons.
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color
  assign overlay_alpha = section.settings.overlay_opacity | times: 1.0 | divided_by: 100

  # Bottom fade: eased multi-stop gradient (fast drop near the top of the
  # fade zone, gentler near the section edge) instead of a single flat
  # linear ramp, so it reads as a smooth fade rather than a hard band.
  assign bf_peak = section.settings.bottom_fade_opacity | times: 1.0 | divided_by: 100
  assign bf_alpha1 = bf_peak | times: 0.85
  assign bf_alpha2 = bf_peak | times: 0.55
  assign bf_alpha3 = bf_peak | times: 0.22
  assign bf_color0 = section.settings.bottom_fade_color | color_modify: 'alpha', bf_peak
  assign bf_color1 = section.settings.bottom_fade_color | color_modify: 'alpha', bf_alpha1
  assign bf_color2 = section.settings.bottom_fade_color | color_modify: 'alpha', bf_alpha2
  assign bf_color3 = section.settings.bottom_fade_color | color_modify: 'alpha', bf_alpha3
  assign bf_size = section.settings.bottom_fade_size
  assign bf_pos1 = bf_size | times: 0.3 | round
  assign bf_pos2 = bf_size | times: 0.55 | round
  assign bf_pos3 = bf_size | times: 0.8 | round
  assign bottom_fade_gradient = 'linear-gradient(to top, ' | append: bf_color0 | append: ' 0%, ' | append: bf_color1 | append: ' ' | append: bf_pos1 | append: '%, ' | append: bf_color2 | append: ' ' | append: bf_pos2 | append: '%, ' | append: bf_color3 | append: ' ' | append: bf_pos3 | append: '%, transparent ' | append: bf_size | append: '%)'

  # Same eased curve for the top fade, mirrored (to bottom).
  assign tf_peak = section.settings.top_fade_opacity | times: 1.0 | divided_by: 100
  assign tf_alpha1 = tf_peak | times: 0.85
  assign tf_alpha2 = tf_peak | times: 0.55
  assign tf_alpha3 = tf_peak | times: 0.22
  assign tf_color0 = section.settings.top_fade_color | color_modify: 'alpha', tf_peak
  assign tf_color1 = section.settings.top_fade_color | color_modify: 'alpha', tf_alpha1
  assign tf_color2 = section.settings.top_fade_color | color_modify: 'alpha', tf_alpha2
  assign tf_color3 = section.settings.top_fade_color | color_modify: 'alpha', tf_alpha3
  assign tf_size = section.settings.top_fade_size
  assign tf_pos1 = tf_size | times: 0.3 | round
  assign tf_pos2 = tf_size | times: 0.55 | round
  assign tf_pos3 = tf_size | times: 0.8 | round
  assign top_fade_gradient = 'linear-gradient(to bottom, ' | append: tf_color0 | append: ' 0%, ' | append: tf_color1 | append: ' ' | append: tf_pos1 | append: '%, ' | append: tf_color2 | append: ' ' | append: tf_pos2 | append: '%, ' | append: tf_color3 | append: ' ' | append: tf_pos3 | append: '%, transparent ' | append: tf_size | append: '%)'

  assign heading_glow_alpha = section.settings.heading_glow_strength | times: 1.0 | divided_by: 100
  assign heading_glow_rgba = section.settings.heading_glow_color | color_modify: 'alpha', heading_glow_alpha
  assign heading_glow_radius_2 = section.settings.heading_glow_size | times: 2.25 | round

  assign ambient_glow_alpha = section.settings.ambient_glow_strength | times: 1.0 | divided_by: 100
  assign ambient_glow_rgba = accent | color_modify: 'alpha', ambient_glow_alpha

  case section.settings.height_mode
    when 'full_screen'
      assign min_height = '100svh'
      assign min_height_mobile = '100svh'
    when 'large'
      assign min_height = '85vh'
      assign min_height_mobile = '70vh'
    when 'medium'
      assign min_height = '65vh'
      assign min_height_mobile = '55vh'
    when 'small'
      assign min_height = '45vh'
      assign min_height_mobile = '38vh'
    else
      assign min_height = section.settings.custom_height | append: 'px'
      assign min_height_mobile = section.settings.custom_height_mobile | append: 'px'
  endcase

  assign vertical_map_top = 'flex-start'
  assign vertical_map_center = 'center'
  assign vertical_map_bottom = 'flex-end'

  assign content_justify = vertical_map_center
  if section.settings.content_vertical_align == 'top'
    assign content_justify = vertical_map_top
  elsif section.settings.content_vertical_align == 'bottom'
    assign content_justify = vertical_map_bottom
  endif

  assign content_justify_mobile = vertical_map_center
  if section.settings.content_vertical_align_mobile == 'top'
    assign content_justify_mobile = vertical_map_top
  elsif section.settings.content_vertical_align_mobile == 'bottom'
    assign content_justify_mobile = vertical_map_bottom
  endif

  assign content_items_align = 'center'
  if section.settings.content_align == 'left'
    assign content_items_align = 'flex-start'
  elsif section.settings.content_align == 'right'
    assign content_items_align = 'flex-end'
  endif

  assign content_items_align_mobile = 'center'
  if section.settings.content_align_mobile == 'left'
    assign content_items_align_mobile = 'flex-start'
  elsif section.settings.content_align_mobile == 'right'
    assign content_items_align_mobile = 'flex-end'
  endif
-%}

<div
  id="HeroBanner-{{ section.id }}"
  class="hero-banner-{{ section.id }} hero-banner color-{{ section.settings.color_scheme }}"
  style="
    --hb-accent: {{ accent }};
    --hb-heading-color: {{ section.settings.heading_color }};
    --hb-min-height: {{ min_height }};
    --hb-min-height-mobile: {{ min_height_mobile }};
    --hb-content-max-width: {{ section.settings.content_max_width }}px;
    --hb-content-justify: {{ content_justify }};
    --hb-content-justify-mobile: {{ content_justify_mobile }};
    --hb-content-items-align: {{ content_items_align }};
    --hb-content-items-align-mobile: {{ content_items_align_mobile }};
    --hb-text-align: {{ section.settings.content_align }};
    --hb-text-align-mobile: {{ section.settings.content_align_mobile }};
    --hb-overlay-alpha: {{ overlay_alpha }};
    --hb-bottom-fade-gradient: {{ bottom_fade_gradient }};
    --hb-top-fade-gradient: {{ top_fade_gradient }};
    --hb-ambient-color: {{ ambient_glow_rgba }};
    --hb-heading-glow-color: {{ heading_glow_rgba }};
    --hb-heading-glow-radius-1: {{ section.settings.heading_glow_size }}px;
    --hb-heading-glow-radius-2: {{ heading_glow_radius_2 }}px;
    --hb-image-position: {{ section.settings.image_position }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hero-banner__media" aria-hidden="true">
    {%- case section.settings.background_style -%}
      {%- when 'video' -%}
        {%- if section.settings.background_video != blank -%}
          {{
            section.settings.background_video
            | video_tag:
              image_size: '2600x',
              autoplay: true,
              loop: section.settings.video_loop,
              muted: true,
              playsinline: true,
              controls: false,
              class: 'hero-banner__video'
          }}
        {%- endif -%}
      {%- when 'image' -%}
        {%- if section.settings.background_image_mobile != blank -%}
          {{
            section.settings.background_image_mobile
            | image_url: width: 1600
            | image_tag:
              widths: '480, 750, 1100, 1600',
              alt: section.settings.background_image_mobile.alt,
              class: 'hero-banner__image hero-banner__image--mobile',
              sizes: '100vw',
              fetchpriority: 'high'
          }}
        {%- endif -%}
        {%- if section.settings.background_image != blank -%}
          {{
            section.settings.background_image
            | image_url: width: 3840
            | image_tag:
              widths: '750, 1100, 1500, 2000, 3000, 3840',
              alt: section.settings.background_image.alt,
              class: 'hero-banner__image hero-banner__image--desktop',
              sizes: '100vw',
              fetchpriority: 'high'
          }}
        {%- endif -%}
      {%- when 'gradient' -%}
        <div class="hero-banner__gradient" style="background-image: {{ section.settings.background_gradient }};"></div>
      {%- when 'solid' -%}
        <div class="hero-banner__solid" style="background-color: {{ section.settings.background_color }};"></div>
    {%- endcase -%}
  </div>

  {%- if section.settings.enable_bg_blur -%}
    <style>
      .hero-banner-{{ section.id }} .hero-banner__media {
        filter: blur({{ section.settings.bg_blur_amount }}px);
        transform: scale(1.1);
      }
    </style>
  {%- endif -%}

  {%- if section.settings.enable_overlay -%}
    <div class="hero-banner__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero-banner__ambient" aria-hidden="true"></div>

  {%- if section.settings.enable_top_fade -%}
    <div class="hero-banner__top-fade" aria-hidden="true"></div>
  {%- endif -%}

  {%- if section.settings.enable_bottom_fade -%}
    <div class="hero-banner__bottom-fade" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero-banner__content-wrap">
    <div class="hero-banner__content">
      {%- if section.settings.eyebrow_text != blank -%}
        <span class="hero-banner__eyebrow">{{ section.settings.eyebrow_text }}</span>
      {%- endif -%}

      {%- if section.settings.heading_text != blank -%}
        <div
          class="hero-banner__heading{% if section.settings.heading_glow %} hero-banner__heading--glow{% endif %}"
          role="heading"
          aria-level="1"
        >
          {{ section.settings.heading_text }}
        </div>
      {%- endif -%}

      {%- if section.settings.subheading_text != blank -%}
        <div class="hero-banner__subheading">{{ section.settings.subheading_text }}</div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'countdown' -%}
          <div
            class="hero-banner__countdown"
            data-countdown
            data-end="{{ block.settings.year }}-{{ block.settings.month }}-{{ block.settings.day }}T{{ block.settings.hour }}:{{ block.settings.minute }}:00Z"
            data-hide-on-complete="{{ block.settings.hide_on_complete }}"
            {{ block.shopify_attributes }}
          >
            <div class="hero-banner__countdown-item" data-unit="days">
              <span class="hero-banner__countdown-num" data-value>00</span>
              <span class="hero-banner__countdown-label">{{ block.settings.days_text }}</span>
            </div>
            <span class="hero-banner__countdown-sep" aria-hidden="true">:</span>
            <div class="hero-banner__countdown-item" data-unit="hours">
              <span class="hero-banner__countdown-num" data-value>00</span>
              <span class="hero-banner__countdown-label">{{ block.settings.hours_text }}</span>
            </div>
            <span class="hero-banner__countdown-sep" aria-hidden="true">:</span>
            <div class="hero-banner__countdown-item" data-unit="minutes">
              <span class="hero-banner__countdown-num" data-value>00</span>
              <span class="hero-banner__countdown-label">{{ block.settings.minutes_text }}</span>
            </div>
            <span class="hero-banner__countdown-sep" aria-hidden="true">:</span>
            <div class="hero-banner__countdown-item" data-unit="seconds">
              <span class="hero-banner__countdown-num" data-value>00</span>
              <span class="hero-banner__countdown-label">{{ block.settings.seconds_text }}</span>
            </div>
          </div>
          <p class="hero-banner__countdown-complete" data-countdown-complete hidden>{{ block.settings.completed_text }}</p>
        {%- endif -%}
      {%- endfor -%}

      {%- assign button_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'button' -%}{%- assign button_count = button_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}

      {%- if button_count > 0 -%}
        <div class="hero-banner__actions">
          {%- for block in section.blocks -%}
            {%- if block.type == 'button' -%}
              <a
                {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}href="javascript:void(0);"{% endif %}
                {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
                class="hero-banner-button hero-banner-button--{{ block.settings.style }}"
                style="
                  border-radius: {{ block.settings.corner_radius }}px;
                  {% if block.settings.style == 'outline' %}
                    color: {{ block.settings.bg_color }};
                    border-color: {{ block.settings.bg_color }};
                  {% else %}
                    background-color: {{ block.settings.bg_color }};
                    color: {{ block.settings.text_color }};
                  {% endif %}
                  {% if block.settings.style == 'glow' %}
                    box-shadow:
                      0 0 {{ block.settings.glow_size | times: 0.5 | round }}px color-mix(in srgb, {{ block.settings.glow_color }} 55%, transparent),
                      0 0 {{ block.settings.glow_size }}px color-mix(in srgb, {{ block.settings.glow_color }} 35%, transparent),
                      0 0 {{ block.settings.glow_size | times: 2.25 | round }}px color-mix(in srgb, {{ block.settings.glow_color }} 15%, transparent);
                  {% endif %}
                "
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label }}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .hero-banner-{{ section.id }} {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    min-height: var(--hb-min-height-mobile);
    background: #000;
  }

  @media screen and (min-width: 750px) {
    .hero-banner-{{ section.id }} {
      min-height: var(--hb-min-height);
    }
  }

  .hero-banner-{{ section.id }} .hero-banner__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-banner-{{ section.id }} .hero-banner__video,
  .hero-banner-{{ section.id }} .hero-banner__image,
  .hero-banner-{{ section.id }} .hero-banner__gradient,
  .hero-banner-{{ section.id }} .hero-banner__solid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hb-image-position);
  }

  .hero-banner-{{ section.id }} .hero-banner__image--mobile {
    display: none;
  }

  .hero-banner-{{ section.id }} .hero-banner__image--desktop {
    display: block;
  }

  @media screen and (max-width: 749px) {
    .hero-banner-{{ section.id }} .hero-banner__image--mobile {
      display: block;
    }

    .hero-banner-{{ section.id }} .hero-banner__image--mobile ~ .hero-banner__image--desktop {
      display: none;
    }
  }

  .hero-banner-{{ section.id }} .hero-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, var(--hb-overlay-alpha));
    pointer-events: none;
  }

  .hero-banner-{{ section.id }} .hero-banner__ambient {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(60% 70% at 20% 20%, var(--hb-ambient-color), transparent 70%);
    pointer-events: none;
  }

  .hero-banner-{{ section.id }} .hero-banner__top-fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: var(--hb-top-fade-gradient);
    pointer-events: none;
  }

  .hero-banner-{{ section.id }} .hero-banner__bottom-fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: var(--hb-bottom-fade-gradient);
    pointer-events: none;
  }

  .hero-banner-{{ section.id }} .hero-banner__content-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    width: 100%;
    padding-inline: 20px;
  }

  .hero-banner-{{ section.id }} .hero-banner__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    max-width: var(--hb-content-max-width);
    margin-inline: auto;
    align-items: var(--hb-content-items-align-mobile);
    justify-content: var(--hb-content-justify-mobile);
    text-align: var(--hb-text-align-mobile);
    padding-block: 48px;
  }

  @media screen and (min-width: 750px) {
    .hero-banner-{{ section.id }} .hero-banner__content-wrap {
      padding-inline: 48px;
    }

    .hero-banner-{{ section.id }} .hero-banner__content {
      align-items: var(--hb-content-items-align);
      justify-content: var(--hb-content-justify);
      text-align: var(--hb-text-align);
      padding-block: 64px;
    }
  }

  .hero-banner-{{ section.id }} .hero-banner__eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 6px 16px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--hb-accent) 45%, transparent);
    background: color-mix(in srgb, var(--hb-accent) 14%, transparent);
    color: var(--hb-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-banner-{{ section.id }} .hero-banner__heading {
    margin: 0;
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    font-size: clamp(2.2rem, 1.6rem + 4vw, 5.2rem);
    background: linear-gradient(160deg, var(--hb-heading-color) 10%, var(--hb-accent) 120%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-banner-{{ section.id }} .hero-banner__heading p {
    margin: 0;
  }

  .hero-banner-{{ section.id }} .hero-banner__heading em {
    font-style: normal;
    color: var(--hb-accent);
  }

  {%- if section.settings.heading_use_custom_fonts -%}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
    {{ section.settings.heading_accent_font | font_face: font_display: 'swap' }}

    .hero-banner-{{ section.id }} .hero-banner__heading {
      font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      font-weight: {{ section.settings.heading_font.weight }};
      font-style: {{ section.settings.heading_font.style }};
    }

    .hero-banner-{{ section.id }} .hero-banner__heading em {
      font-family: {{ section.settings.heading_accent_font.family }}, {{ section.settings.heading_accent_font.fallback_families }};
      font-weight: {{ section.settings.heading_accent_font.weight }};
      font-style: {{ section.settings.heading_accent_font.style }};
    }
  {%- endif -%}

  .hero-banner-{{ section.id }} .hero-banner__heading--glow {
    filter:
      drop-shadow(0 0 var(--hb-heading-glow-radius-1) var(--hb-heading-glow-color))
      drop-shadow(0 0 var(--hb-heading-glow-radius-2) var(--hb-heading-glow-color));
  }

  .hero-banner-{{ section.id }} .hero-banner__subheading {
    max-width: 56ch;
    color: rgba(255, 255, 255, 0.8);
    font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.15rem);
    line-height: 1.6;
  }

  .hero-banner-{{ section.id }} .hero-banner__subheading p {
    margin: 0;
  }

  .hero-banner-{{ section.id }} .hero-banner__countdown {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
  }

  .hero-banner-{{ section.id }} .hero-banner__countdown-item[hidden] {
    display: none;
  }

  .hero-banner-{{ section.id }} .hero-banner__countdown-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 58px;
    padding: 10px 12px;
    border-radius: 14px;
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 12px 28px -18px rgba(0, 0, 0, 0.8);
  }

  .hero-banner-{{ section.id }} .hero-banner__countdown-num {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    background: linear-gradient(160deg, var(--hb-heading-color) 10%, var(--hb-accent) 120%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-banner-{{ section.id }} .hero-banner__countdown-label {
    margin-top: 4px;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero-banner-{{ section.id }} .hero-banner__countdown-sep {
    font-weight: 800;
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.3);
    transform: translateY(-8px);
  }

  .hero-banner-{{ section.id }} .hero-banner__countdown-sep[hidden] {
    display: none;
  }

  .hero-banner-{{ section.id }} .hero-banner__countdown-complete {
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.95rem;
  }

  @media screen and (min-width: 750px) {
    .hero-banner-{{ section.id }} .hero-banner__countdown {
      gap: 12px;
    }

    .hero-banner-{{ section.id }} .hero-banner__countdown-item {
      min-width: 72px;
      padding: 14px 16px;
    }

    .hero-banner-{{ section.id }} .hero-banner__countdown-num {
      font-size: 1.9rem;
    }
  }

  .hero-banner-{{ section.id }} .hero-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 8px;
    justify-content: var(--hb-content-items-align-mobile);
  }

  @media screen and (min-width: 750px) {
    .hero-banner-{{ section.id }} .hero-banner__actions {
      justify-content: var(--hb-content-items-align);
    }
  }

  .hero-banner-{{ section.id }} .hero-banner-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 15px 34px;
    white-space: nowrap;
    transition: box-shadow 0.25s ease, transform 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }

  .hero-banner-{{ section.id }} .hero-banner-button:hover {
    transform: translateY(-2px);
  }

  .hero-banner-{{ section.id }} .hero-banner-button--solid {
    border: none;
  }

  .hero-banner-{{ section.id }} .hero-banner-button--outline {
    background: transparent !important;
    border-width: 2px;
    border-style: solid;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-banner-{{ section.id }} .hero-banner-button {
      transition: none;
    }

    .hero-banner-{{ section.id }} .hero-banner-button:hover {
      transform: none;
    }
  }
</style>

<script>
  (function () {
    var rootSelector = '.hero-banner-{{ section.id }}';

    function initCountdown(root) {
      var el = root.querySelector('[data-countdown]');
      if (!el || el.dataset.countdownBound) return;
      el.dataset.countdownBound = 'true';

      var endTime = new Date(el.dataset.end).getTime();
      var hideOnComplete = el.dataset.hideOnComplete === 'true';
      var completeEl = root.querySelector('[data-countdown-complete]');
      var daysItem = el.querySelector('[data-unit="days"]');
      var timerId = null;

      function setUnit(unit, value) {
        var item = el.querySelector('[data-unit="' + unit + '"] [data-value]');
        if (item) item.textContent = String(value).padStart(2, '0');
      }

      function tick() {
        var diff = endTime - Date.now();

        if (diff <= 0) {
          clearInterval(timerId);
          if (hideOnComplete) {
            el.hidden = true;
          } else {
            el.querySelectorAll('[data-value]').forEach(function (n) {
              n.textContent = '00';
            });
          }
          if (completeEl) completeEl.hidden = false;
          return;
        }

        var day = 86400000;
        var hour = 3600000;
        var minute = 60000;
        var days = Math.floor(diff / day);
        var hours = Math.floor((diff % day) / hour);
        var minutes = Math.floor((diff % hour) / minute);
        var seconds = Math.floor((diff % minute) / 1000);

        if (daysItem) {
          var showDays = days > 0;
          daysItem.hidden = !showDays;
          if (daysItem.nextElementSibling) daysItem.nextElementSibling.hidden = !showDays;
        }

        setUnit('days', days);
        setUnit('hours', hours);
        setUnit('minutes', minutes);
        setUnit('seconds', seconds);
      }

      tick();
      timerId = setInterval(tick, 1000);

      document.addEventListener('shopify:section:unload', function (e) {
        if (e.detail.sectionId === '{{ section.id }}') clearInterval(timerId);
      });
    }

    function init() {
      var root = document.querySelector(rootSelector);
      if (!root) return;
      initCountdown(root);
    }

    init();
    document.addEventListener('shopify:section:load', init);
  })();
</script>

