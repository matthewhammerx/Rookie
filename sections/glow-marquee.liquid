<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="glow-marquee-{{ section.id }} glow-marquee section section--full-width color-{{ section.settings.color_scheme }}"
>
  <div class="glow-marquee__ambient" aria-hidden="true"></div>

  <div class="glow-marquee__viewport">
    <div
      class="glow-marquee__track"
      data-marquee-track
      data-marquee-duration="{{ section.settings.speed }}"
      style="animation-duration: {{ section.settings.speed }}s;"
    >
      {% for i in (1..2) %}
        <div
          class="glow-marquee__set"
          {% if i == 1 %}
            data-marquee-set
          {% endif %}
          aria-hidden="{% if i == 2 %}true{% else %}false{% endif %}"
        >
          {% for block in section.blocks %}
            <span class="glow-marquee__item">
              {% if block.settings.text != blank %}
                <span class="glow-marquee__text">{{ block.settings.text }}</span>
              {% endif %}
              {% if block.settings.badge_text != blank %}
                <span class="glow-marquee__badge">{{ block.settings.badge_text }}</span>
              {% endif %}
            </span>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% stylesheet %}
  .glow-marquee-{{ section.id }} {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .glow-marquee-{{ section.id }} .glow-marquee__ambient {
    position: absolute;
    inset: 0;
    background: radial-gradient(65% 90% at 50% 50%, {{ section.settings.accent_color }}22, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  .glow-marquee-{{ section.id }} .glow-marquee__viewport {
    position: relative;
    z-index: 1;
    overflow: hidden;
    width: 100%;
  }

  .glow-marquee-{{ section.id }} .glow-marquee__track {
    display: flex;
    width: max-content;
    animation-name: glowMarqueeScroll-{{ section.id }};
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .glow-marquee-{{ section.id }} .glow-marquee__set {
    display: flex;
    align-items: center;
  }

  .glow-marquee-{{ section.id }} .glow-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    white-space: nowrap;
    padding-inline: 32px;
    font-family: var(--font-heading--family, inherit);
    font-weight: 700;
    font-size: clamp(1.2rem, 1.05rem + 0.9vw, 1.7rem);
    background: linear-gradient(160deg, #ffffff 20%, {{ section.settings.accent_color }} 130%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .glow-marquee-{{ section.id }} .glow-marquee__badge {
    display: inline-flex;
    align-items: center;
    padding: 9px 22px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #ffffff;
    background: linear-gradient(165deg, rgba(40, 20, 34, 0.85), rgba(20, 10, 18, 0.75));
    border: 1px solid {{ section.settings.accent_color }}66;
    box-shadow: 0 0 24px -6px {{ section.settings.accent_color }}80;
  }

  @keyframes glowMarqueeScroll-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--marquee-distance, -50%));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow-marquee-{{ section.id }} .glow-marquee__track {
      animation: none;
    }

    .glow-marquee-{{ section.id }} .glow-marquee__set[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var sectionRoot = document.querySelector('.glow-marquee-{{ section.id }}');
    if (!sectionRoot) return;

    var track = sectionRoot.querySelector('[data-marquee-track]');
    if (!track || track.dataset.marqueeBound) return;
    track.dataset.marqueeBound = 'true';

    var originalSet = track.querySelector('[data-marquee-set]');
    if (!originalSet) return;

    var resizeTimer = null;

    function rebuild() {
      // Drop every clone except the original set and its single aria-hidden twin.
      var sets = track.querySelectorAll('.glow-marquee__set');
      for (var i = 2; i < sets.length; i++) {
        sets[i].remove();
      }

      var setWidth = originalSet.getBoundingClientRect().width;
      if (!setWidth) return;

      var viewportWidth = track.parentElement.getBoundingClientRect().width;
      var totalWidth = setWidth * track.querySelectorAll('.glow-marquee__set').length;

      while (totalWidth < viewportWidth * 2) {
        var clone = originalSet.cloneNode(true);
        clone.removeAttribute('data-marquee-set');
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
        totalWidth += setWidth;
      }

      track.style.setProperty('--marquee-distance', -setWidth + 'px');
    }

    rebuild();

    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(rebuild);
    }

    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(rebuild, 200);
    });

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        track.dataset.marqueeBound = '';
        rebuild();
        track.dataset.marqueeBound = 'true';
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Glow Marquee",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color (badge, glow, text)",
      "default": "#eb00ca"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed (seconds per loop)",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "s",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "info": "Optional — shown as a glass pill next to the text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glow Marquee",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Fast & reliable shipping",
            "badge_text": "we are legends"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Free shipping on US & CAD orders $350+",
            "badge_text": "we are legends"
          }
        }
      ]
    }
  ]
}
{% endschema %}
