{% comment %}
  Trust Badge
  A single horizontal pill -- gold stars + one bold text line -- with
  a translucent glass background so it reads well sitting over photos
  or video, matching the reference "Trusted by 10,000+ customers"
  badge style. Fully generic/editable text, not tied to any review
  platform.
{% endcomment %}

{%- liquid
  assign bg_alpha = section.settings.background_opacity | times: 1.0 | divided_by: 100
  assign bg_rgba = section.settings.background_color | color_modify: 'alpha', bg_alpha
-%}

<div class="tpb color-{{ section.settings.color_scheme }}">
  {%- liquid
    assign tag = 'div'
    if section.settings.link_url != blank
      assign tag = 'a'
    endif
  -%}

  <{{ tag }}
    class="tpb__badge"
    data-pause-offscreen
    style="
      --tpb-bg: {{ bg_rgba }};
      --tpb-star-color: {{ section.settings.star_color }};
      --tpb-text-color: {{ section.settings.text_color }};
    "
    {% if section.settings.link_url != blank %}
      href="{{ section.settings.link_url }}"
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
  >
    <span class="tpb__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <svg viewBox="0 0 24 24" width="15" height="15" class="tpb__star">
          <path d="M12 2.5l2.9 6 6.6.7-4.9 4.5 1.3 6.5-5.9-3.3-5.9 3.3 1.3-6.5-4.9-4.5 6.6-.7z" fill="currentColor" />
        </svg>
      {%- endfor -%}
    </span>

    <span class="tpb__text">{{ section.settings.badge_text }}</span>
  </{{ tag }}>
</div>

{% stylesheet %}
  .tpb {
    display: flex;
    justify-content: center;
    padding-top: 24px;
    padding-bottom: 24px;
  }

  .tpb__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    border-radius: 999px;
    background: var(--tpb-bg);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 47, 177, 0.35);
    color: var(--tpb-text-color);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
    animation: tpb-glow-pulse 2.6s ease-in-out infinite;
  }

  @media (max-width: 749px) {
    .tpb__badge {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  a.tpb__badge:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 47, 177, 0.6);
  }

  @keyframes tpb-glow-pulse {
    0%,
    100% {
      box-shadow: 0 0 16px 0 rgba(255, 47, 177, 0.22);
    }
    50% {
      box-shadow: 0 0 34px 2px rgba(255, 47, 177, 0.45);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tpb__badge {
      animation: none;
      box-shadow: 0 0 20px rgba(255, 47, 177, 0.25);
    }
  }

  .tpb__stars {
    display: flex;
    gap: 1px;
    color: var(--tpb-star-color);
    flex: none;
  }

  .tpb__text {
    font-size: 0.875rem;
    font-weight: 700;
    white-space: nowrap;
  }

  @media screen and (max-width: 480px) {
    .tpb__badge {
      padding: 8px 14px;
    }

    .tpb__text {
      font-size: 0.8rem;
      white-space: normal;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Badge",
  "tag": "section",
  "class": "tpb-wrapper section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Trusted by 10,000+ customers"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link (optional)"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#ffb800"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "background_opacity",
      "label": "Background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 40,
      "info": "Low opacity gives a glassy, see-through look over photos/video behind it."
    }
  ],
  "presets": [
    {
      "name": "Trust Badge"
    }
  ]
}
{% endschema %}
