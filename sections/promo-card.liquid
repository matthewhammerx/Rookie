{% comment %}
  Promo Card
  A single big rounded clickable card/banner (no video) for driving traffic
  to one destination -- e.g. a Mystery Bags page. Optional background image;
  without one it falls back to the site's glass-morphism card treatment.
{% endcomment %}

{%- liquid
  assign accent = section.settings.accent_color
  assign overlay_opacity_decimal = section.settings.image_overlay_opacity | times: 1.0 | divided_by: 100
  assign glow_alpha = section.settings.glow_strength | times: 1.0 | divided_by: 100
  assign glow_rgba = accent | color_modify: 'alpha', glow_alpha
  assign border_rgba = accent | color_modify: 'alpha', 0.55
  assign eyebrow_border_rgba = section.settings.eyebrow_color | color_modify: 'alpha', 0.55
  assign subheading_alpha = section.settings.subheading_opacity | times: 1.0 | divided_by: 100
  assign subheading_rgba = section.settings.subheading_color | color_modify: 'alpha', subheading_alpha

  assign content_align_items = 'flex-start'
  if section.settings.content_alignment == 'center'
    assign content_align_items = 'center'
  elsif section.settings.content_alignment == 'right'
    assign content_align_items = 'flex-end'
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="promo-card-{{ section.id }} promo-card section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="
    --pc-accent: {{ accent }};
    --pc-accent-border: {{ border_rgba }};
    --pc-glow-color: {{ glow_rgba }};
    --pc-glow-size: {{ section.settings.glow_size }}px;
    --pc-heading-color: {{ section.settings.heading_color }};
    --pc-eyebrow-color: {{ section.settings.eyebrow_color }};
    --pc-eyebrow-border: {{ eyebrow_border_rgba }};
    --pc-subheading-color: {{ subheading_rgba }};
    --pc-cta-bg: {{ section.settings.cta_bg_color }};
    --pc-cta-text: {{ section.settings.cta_text_color }};
    --pc-radius: {{ section.settings.corner_radius }}px;
    --pc-height: {{ section.settings.card_height }}px;
    --pc-height-mobile: {{ section.settings.card_height_mobile }}px;
    --pc-overlay-opacity: {{ overlay_opacity_decimal }};
    --pc-section-glow-color: {{ section.settings.section_glow_color }};
    --pc-section-glow-size: {{ section.settings.section_glow_size }}px;
    --pc-section-glow-speed: {{ section.settings.section_glow_speed }}s;
    --pc-heading-image-width: {{ section.settings.heading_image_width }}px;
    --pc-heading-image-width-mobile: {{ section.settings.heading_image_width_mobile }}px;
    --pc-content-align: {{ content_align_items }};
    --pc-text-align: {{ section.settings.content_alignment }};
    --pc-content-offset-x: {{ section.settings.content_offset_x }}px;
    --pc-content-offset-x-mobile: {{ section.settings.content_offset_x_mobile }}px;
    --pc-content-offset-y: {{ section.settings.content_offset_y }}px;
    --pc-content-offset-y-mobile: {{ section.settings.content_offset_y_mobile }}px;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  "
>
  <div class="promo-card__glow-wrapper">
    {%- if section.settings.enable_section_glow -%}
      <div class="promo-card__section-glow promo-card__section-glow--{{ section.settings.section_glow_style }}" data-pause-offscreen aria-hidden="true"></div>
    {%- endif -%}
    <a
      {% if section.settings.link != blank %}href="{{ section.settings.link }}"{% else %}href="javascript:void(0);"{% endif %}
      {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
      class="promo-card__card{% if section.settings.enable_spotlight %} promo-card__card--spotlight{% endif %}"
      aria-label="{{ section.settings.heading_text }}"
    >
    {%- if section.settings.background_image != blank -%}
      <div class="promo-card__media" aria-hidden="true">
        {{
          section.settings.background_image
          | image_url: width: 2400
          | image_tag:
            widths: '480, 750, 1100, 1600, 2000, 2400',
            alt: '',
            class: 'promo-card__image',
            sizes: '100vw'
        }}
      </div>
      <div class="promo-card__overlay" aria-hidden="true"></div>
    {%- endif -%}

    <div class="promo-card__glow" aria-hidden="true"></div>

    <div class="promo-card__content">
      {%- if section.settings.eyebrow_text != blank -%}
        <span class="promo-card__eyebrow">{{ section.settings.eyebrow_text }}</span>
      {%- endif -%}

      {%- if section.settings.heading_image != blank -%}
        {{
          section.settings.heading_image
          | image_url: width: 1200
          | image_tag:
            widths: '300, 500, 800, 1200',
            alt: section.settings.heading_text,
            class: 'promo-card__heading-image',
            loading: 'lazy'
        }}
      {%- elsif section.settings.heading_text != blank -%}
        <h2 class="promo-card__heading">{{ section.settings.heading_text }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading_text != blank -%}
        <p class="promo-card__subheading">{{ section.settings.subheading_text }}</p>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'countdown' -%}
          {%- liquid
            assign cd_backdrop_alpha = block.settings.backdrop_opacity | times: 1.0 | divided_by: 100
            assign cd_backdrop_rgba = block.settings.backdrop_color | color_modify: 'alpha', cd_backdrop_alpha
          -%}
          <div
            class="promo-card__countdown{% unless block.settings.show_separators %} promo-card__countdown--no-sep{% endunless %}{% if block.settings.enable_backdrop %} promo-card__countdown--backdrop{% endif %}"
            data-countdown
            data-end="{{ block.settings.year }}-{{ block.settings.month }}-{{ block.settings.day }}T{{ block.settings.hour }}:{{ block.settings.minute }}:00Z"
            data-hide-on-complete="{{ block.settings.hide_on_complete }}"
            style="
              --pcc-num-start: {{ block.settings.number_color_start }};
              --pcc-num-end: {{ block.settings.number_color_end }};
              --pcc-label-color: {{ block.settings.label_color }};
              {% if block.settings.enable_backdrop %}
                --pcc-backdrop-color: {{ cd_backdrop_rgba }};
                --pcc-backdrop-radius: {{ block.settings.backdrop_radius }}px;
              {% endif %}
            "
            {{ block.shopify_attributes }}
          >
            <div class="promo-card__countdown-item" data-unit="days">
              <span class="promo-card__countdown-num" data-value>00</span>
              <span class="promo-card__countdown-label">{{ block.settings.days_text }}</span>
            </div>
            <span class="promo-card__countdown-sep" aria-hidden="true">:</span>
            <div class="promo-card__countdown-item" data-unit="hours">
              <span class="promo-card__countdown-num" data-value>00</span>
              <span class="promo-card__countdown-label">{{ block.settings.hours_text }}</span>
            </div>
            <span class="promo-card__countdown-sep" aria-hidden="true">:</span>
            <div class="promo-card__countdown-item" data-unit="minutes">
              <span class="promo-card__countdown-num" data-value>00</span>
              <span class="promo-card__countdown-label">{{ block.settings.minutes_text }}</span>
            </div>
            <span class="promo-card__countdown-sep" aria-hidden="true">:</span>
            <div class="promo-card__countdown-item" data-unit="seconds">
              <span class="promo-card__countdown-num" data-value>00</span>
              <span class="promo-card__countdown-label">{{ block.settings.seconds_text }}</span>
            </div>
          </div>
          <p class="promo-card__countdown-complete" data-countdown-complete hidden>{{ block.settings.completed_text }}</p>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.cta_label != blank -%}
        <span class="promo-card__cta">
          {{ section.settings.cta_label }}
          <svg class="promo-card__cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
      {%- endif -%}
    </div>
    </a>
  </div>
</div>

{% stylesheet %}
  .promo-card-{{ section.id }} .promo-card__glow-wrapper {
    position: relative;
  }

  .promo-card-{{ section.id }} .promo-card__section-glow {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: var(--pc-radius);
    pointer-events: none;
  }

  .promo-card-{{ section.id }} .promo-card__section-glow--pulse {
    animation: promoCardSectionGlowPulse-{{ section.id }} var(--pc-section-glow-speed) ease-in-out infinite;
  }

  @keyframes promoCardSectionGlowPulse-{{ section.id }} {
    0%,
    100% {
      box-shadow: 0 0 var(--pc-section-glow-size) 0 color-mix(in srgb, var(--pc-section-glow-color) 30%, transparent);
    }
    50% {
      box-shadow: 0 0 calc(var(--pc-section-glow-size) * 1.7) calc(var(--pc-section-glow-size) * 0.25)
        color-mix(in srgb, var(--pc-section-glow-color) 65%, transparent);
    }
  }

  @property --pc-glow-angle-{{ section.id }} {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  .promo-card-{{ section.id }} .promo-card__section-glow--orbit {
    --pc-glow-angle-{{ section.id }}: 0deg;
    inset: calc(var(--pc-section-glow-size) * -0.5);
    background: conic-gradient(
      from var(--pc-glow-angle-{{ section.id }}),
      transparent 0%,
      color-mix(in srgb, var(--pc-section-glow-color) 85%, transparent) 8%,
      transparent 22%
    );
    filter: blur(calc(var(--pc-section-glow-size) * 0.5));
    animation: promoCardSectionGlowOrbit-{{ section.id }} var(--pc-section-glow-speed) linear infinite;
  }

  /*
    This blur+border-radius pairing is unreliable specifically on
    mobile Safari (iOS), where the blur can leak past the rounded
    corners in a square instead of following them. Desktop renders it
    correctly already, so this only touches mobile widths -- a mask
    forces Safari to respect the radius, and stays solid white (no
    fade of its own) so it doesn't cut the glow's own falloff short.
  */
  @media screen and (max-width: 749px) {
    .promo-card-{{ section.id }} .promo-card__section-glow--orbit {
      -webkit-mask-image: -webkit-radial-gradient(white, white);
      mask-image: radial-gradient(white, white);
    }
  }

  @keyframes promoCardSectionGlowOrbit-{{ section.id }} {
    to {
      --pc-glow-angle-{{ section.id }}: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-card-{{ section.id }} .promo-card__section-glow {
      animation: none !important;
      inset: 0;
      filter: none;
      background: none;
      box-shadow: 0 0 var(--pc-section-glow-size) 0 color-mix(in srgb, var(--pc-section-glow-color) 45%, transparent);
    }
  }

  .promo-card-{{ section.id }} .promo-card__card {
    position: relative;
    z-index: 1;
    display: block;
    isolation: isolate;
    overflow: hidden;
    min-height: var(--pc-height-mobile);
    border-radius: var(--pc-radius);
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.75);
    text-decoration: none;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }

  @media screen and (min-width: 750px) {
    .promo-card-{{ section.id }} .promo-card__card {
      min-height: var(--pc-height);
    }
  }

  .promo-card-{{ section.id }} .promo-card__card:hover {
    transform: translateY(-4px) scale(1.015);
    border-color: var(--pc-accent-border);
    box-shadow: 0 28px 70px -28px rgba(0, 0, 0, 0.8), 0 0 60px -14px var(--pc-accent-border);
  }

  .promo-card-{{ section.id }} .promo-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .promo-card-{{ section.id }} .promo-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .promo-card-{{ section.id }} .promo-card__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      15deg,
      rgba(0, 0, 0, var(--pc-overlay-opacity)) 20%,
      rgba(0, 0, 0, calc(var(--pc-overlay-opacity) * 0.35)) 100%
    );
    pointer-events: none;
  }

  .promo-card-{{ section.id }} .promo-card__glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(var(--pc-glow-size) circle at var(--pc-spot-x, 25%) var(--pc-spot-y, 50%), var(--pc-glow-color), transparent 68%);
    opacity: 0.55;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .promo-card-{{ section.id }} .promo-card__card--spotlight:hover .promo-card__glow {
    opacity: 1;
  }

  .promo-card-{{ section.id }} .promo-card__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: var(--pc-content-align);
    justify-content: center;
    text-align: var(--pc-text-align);
    height: 100%;
    gap: 10px;
    padding: 32px 26px;
    transform: translate(var(--pc-content-offset-x-mobile), var(--pc-content-offset-y-mobile));
  }

  .promo-card-{{ section.id }} .promo-card__content > * {
    text-align: var(--pc-text-align);
  }

  @media screen and (min-width: 750px) {
    .promo-card-{{ section.id }} .promo-card__content {
      padding: 48px 56px;
      max-width: 640px;
      transform: translate(var(--pc-content-offset-x), var(--pc-content-offset-y));
    }
  }

  .promo-card-{{ section.id }} .promo-card__eyebrow {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid var(--pc-eyebrow-border);
    background: color-mix(in srgb, var(--pc-eyebrow-color) 16%, transparent);
    color: var(--pc-eyebrow-color);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .promo-card-{{ section.id }} .promo-card__heading {
    margin: 0;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    font-size: clamp(1.7rem, 1.3rem + 2vw, 2.6rem);
    background: linear-gradient(160deg, var(--pc-heading-color) 10%, var(--pc-accent) 120%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .promo-card-{{ section.id }} .promo-card__heading-image {
    display: block;
    width: 100%;
    max-width: var(--pc-heading-image-width-mobile);
    height: auto;
  }

  @media screen and (min-width: 750px) {
    .promo-card-{{ section.id }} .promo-card__heading-image {
      max-width: var(--pc-heading-image-width);
    }
  }

  .promo-card-{{ section.id }} .promo-card__subheading {
    margin: 0;
    max-width: 46ch;
    color: var(--pc-subheading-color);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .promo-card-{{ section.id }} .promo-card__countdown {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
  }

  .promo-card-{{ section.id }} .promo-card__countdown-item[hidden] {
    display: none;
  }

  .promo-card-{{ section.id }} .promo-card__countdown-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    padding: 8px 10px;
    border-radius: 14px;
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 16px 30px -14px rgba(0, 0, 0, 0.9),
      0 6px 14px -8px rgba(0, 0, 0, 0.6),
      0 0 22px -8px color-mix(in srgb, var(--pc-accent) 45%, transparent);
  }

  .promo-card-{{ section.id }} .promo-card__countdown--backdrop .promo-card__countdown-item {
    background: var(--pcc-backdrop-color);
    border-radius: var(--pcc-backdrop-radius);
  }

  .promo-card-{{ section.id }} .promo-card__countdown--no-sep .promo-card__countdown-sep {
    display: none;
  }

  .promo-card-{{ section.id }} .promo-card__countdown-num {
    font-variant-numeric: tabular-nums;
    font-weight: 800;
    font-size: 1.3rem;
    line-height: 1;
    background: linear-gradient(160deg, var(--pcc-num-start) 10%, var(--pcc-num-end) 120%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .promo-card-{{ section.id }} .promo-card__countdown-label {
    margin-top: 4px;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pcc-label-color);
  }

  .promo-card-{{ section.id }} .promo-card__countdown-sep {
    font-weight: 800;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.3);
    transform: translateY(-7px);
  }

  .promo-card-{{ section.id }} .promo-card__countdown-sep[hidden] {
    display: none;
  }

  .promo-card-{{ section.id }} .promo-card__countdown-complete {
    margin: 0;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.92rem;
  }

  @media screen and (min-width: 750px) {
    .promo-card-{{ section.id }} .promo-card__countdown {
      gap: 10px;
    }

    .promo-card-{{ section.id }} .promo-card__countdown-item {
      min-width: 62px;
      padding: 10px 14px;
    }

    .promo-card-{{ section.id }} .promo-card__countdown-num {
      font-size: 1.6rem;
    }
  }

  .promo-card-{{ section.id }} .promo-card__cta {
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--pc-cta-bg);
    color: var(--pc-cta-text);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .promo-card-{{ section.id }} .promo-card__cta-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.25s ease;
  }

  .promo-card-{{ section.id }} .promo-card__card:hover .promo-card__cta {
    box-shadow: 0 0 26px -4px var(--pc-accent-border);
  }

  .promo-card-{{ section.id }} .promo-card__card:hover .promo-card__cta-arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .promo-card-{{ section.id }} .promo-card__card,
    .promo-card-{{ section.id }} .promo-card__cta,
    .promo-card-{{ section.id }} .promo-card__cta-arrow,
    .promo-card-{{ section.id }} .promo-card__glow {
      transition: none !important;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var rootSelector = '.promo-card-{{ section.id }}';

    function setSpot(card, clientX, clientY) {
      var rect = card.getBoundingClientRect();
      var x = ((clientX - rect.left) / rect.width) * 100;
      var y = ((clientY - rect.top) / rect.height) * 100;
      card.style.setProperty('--pc-spot-x', x + '%');
      card.style.setProperty('--pc-spot-y', y + '%');
    }

    function init() {
      var root = document.querySelector(rootSelector);
      if (!root) return;

      var card = root.querySelector('.promo-card__card--spotlight');
      if (card && !card.dataset.promoCardBound) {
        card.dataset.promoCardBound = 'true';
        card.addEventListener('pointermove', function (e) {
          setSpot(card, e.clientX, e.clientY);
        });
      }

      initCountdown(root);
    }

    function initCountdown(root) {
      var el = root.querySelector('[data-countdown]');
      if (!el || el.dataset.countdownBound) return;
      el.dataset.countdownBound = 'true';

      var endTime = new Date(el.dataset.end).getTime();
      var hideOnComplete = el.dataset.hideOnComplete === 'true';
      var completeEl = root.querySelector('[data-countdown-complete]');
      var daysItem = el.querySelector('[data-unit="days"]');
      var timerId = null;

      function setUnit(unit, value) {
        var item = el.querySelector('[data-unit="' + unit + '"] [data-value]');
        if (item) item.textContent = String(value).padStart(2, '0');
      }

      function tick() {
        var diff = endTime - Date.now();

        if (diff <= 0) {
          clearInterval(timerId);
          if (hideOnComplete) {
            el.hidden = true;
          } else {
            el.querySelectorAll('[data-value]').forEach(function (n) {
              n.textContent = '00';
            });
          }
          if (completeEl) completeEl.hidden = false;
          return;
        }

        var day = 86400000;
        var hour = 3600000;
        var minute = 60000;
        var days = Math.floor(diff / day);
        var hours = Math.floor((diff % day) / hour);
        var minutes = Math.floor((diff % hour) / minute);
        var seconds = Math.floor((diff % minute) / 1000);

        if (daysItem) {
          var showDays = days > 0;
          daysItem.hidden = !showDays;
          if (daysItem.nextElementSibling) daysItem.nextElementSibling.hidden = !showDays;
        }

        setUnit('days', days);
        setUnit('hours', hours);
        setUnit('minutes', minutes);
        setUnit('seconds', seconds);
      }

      tick();
      timerId = setInterval(tick, 1000);

      document.addEventListener('shopify:section:unload', function (e) {
        if (e.detail.sectionId === '{{ section.id }}') clearInterval(timerId);
      });
    }

    init();
    document.addEventListener('shopify:section:load', init);
  })();
</script>

{% schema %}
{
  "name": "Promo Card",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
