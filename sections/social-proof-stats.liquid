{% stylesheet %}
  .social-proof-stats-{{ section.id }} {
    position: relative;
    z-index: 1;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    display: flex;
    justify-content: center;
  }

  .social-proof-stats-{{ section.id }} .social-proof-stats__ambient {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 90% at 50% 50%, {{ section.settings.accent_color }}26, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .social-proof-stats-{{ section.id }} .social-proof-stats__card {
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 20px 28px;
    padding: 24px 32px;
    margin-inline: 16px;
    border-radius: 20px;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 24px 40px -28px rgba(0, 0, 0, 0.7);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .social-proof-stats-{{ section.id }} .social-proof-stats__glow {
    position: absolute;
    top: -40%;
    left: 30%;
    width: 45%;
    aspect-ratio: 1;
    background: radial-gradient(circle, {{ section.settings.accent_color }}40, transparent 70%);
    filter: blur(20px);
    opacity: 0.7;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .social-proof-stats-{{ section.id }} a.social-proof-stats__card:hover {
    transform: translateY(-4px);
    border-color: {{ section.settings.accent_color }}66;
    box-shadow: 0 30px 50px -24px rgba(0, 0, 0, 0.75), 0 0 40px -12px {{ section.settings.accent_color }}4d;
  }

  .social-proof-stats-{{ section.id }} a.social-proof-stats__card:hover .social-proof-stats__glow {
    opacity: 1;
  }

  .social-proof-stats-{{ section.id }} .social-proof-stats__line {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
  }

  .social-proof-stats-{{ section.id }} .social-proof-stats__divider {
    width: 1px;
    align-self: stretch;
    background: rgba(255, 255, 255, 0.14);
  }

  .social-proof-stats-{{ section.id }} .social-proof-stats__icon {
    position: relative;
    align-self: center;
    width: 20px;
    height: 20px;
    color: {{ section.settings.accent_color }};
  }

  .social-proof-stats-{{ section.id }} .social-proof-stats__value {
    font-family: var(--font-heading--family, inherit);
    font-weight: 800;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.8rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    background: linear-gradient(160deg, #ffffff 10%, {{ section.settings.accent_color }} 110%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .social-proof-stats-{{ section.id }} .social-proof-stats__label {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 480px) {
    .social-proof-stats-{{ section.id }} .social-proof-stats__divider {
      display: none;
    }

    .social-proof-stats-{{ section.id }} .social-proof-stats__card {
      flex-direction: column;
      gap: 14px;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var rootSelector = '.social-proof-stats-{{ section.id }}';
    var duration = 1400;

    function easeOutQuad(t) {
      return 1 - (1 - t) * (1 - t);
    }

    function animateCounter(el) {
      var raw = el.dataset.countTo || '';
      var match = raw.match(/(\d[\d,.]*)/);
      if (!match) {
        el.textContent = raw;
        return;
      }

      var numberPart = match[1].replace(/,/g, '');
      var prefix = raw.slice(0, match.index);
      var suffix = raw.slice(match.index + match[1].length);
      var target = parseFloat(numberPart);
      if (isNaN(target)) {
        el.textContent = raw;
        return;
      }

      var decimals = numberPart.indexOf('.') > -1 ? numberPart.split('.')[1].length : 0;
      var start = null;

      function frame(timestamp) {
        if (start === null) start = timestamp;
        var progress = Math.min((timestamp - start) / duration, 1);
        var eased = easeOutQuad(progress);
        var current = (target * eased).toFixed(decimals);
        el.textContent = prefix + current + suffix;
        if (progress < 1) {
          requestAnimationFrame(frame);
        } else {
          el.textContent = raw;
        }
      }

      requestAnimationFrame(frame);
    }

    function init() {
      var root = document.querySelector(rootSelector);
      if (!root || root.dataset.counterBound) return;
      root.dataset.counterBound = 'true';

      var values = root.querySelectorAll('[data-count-to]');
      if (!values.length) return;

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }

      values.forEach(function (el) {
        el.textContent = '0';
      });

      var observer = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              values.forEach(animateCounter);
              observer.disconnect();
            }
          });
        },
        { threshold: 0.4 }
      );

      observer.observe(root);
    }

    init();
    document.addEventListener('shopify:section:load', init);
  })();
</script>

