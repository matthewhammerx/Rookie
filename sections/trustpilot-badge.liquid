{% comment %}
  Trustpilot Badge (Static)
  A single horizontal pill -- gold stars + one bold line of text --
  matching the reference "Trusted by 10,000+ customers" badge exactly,
  just labeled for Trustpilot. Static/manually-editable, not a live
  Trustpilot embed: keep the text matching your real Trustpilot
  profile so it stays honest, and link it there.
{% endcomment %}

<div
  class="tpb color-{{ section.settings.color_scheme }}"
  style="
    --tpb-bg: {{ section.settings.background_color }};
    --tpb-star-color: {{ section.settings.star_color }};
    --tpb-text-color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- liquid
    assign tag = 'div'
    if section.settings.link_url != blank
      assign tag = 'a'
    endif
  -%}

  <{{ tag }}
    class="tpb__badge"
    {% if section.settings.link_url != blank %}
      href="{{ section.settings.link_url }}"
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
  >
    <span class="tpb__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <svg viewBox="0 0 24 24" width="18" height="18" class="tpb__star">
          <path d="M12 2.5l2.9 6 6.6.7-4.9 4.5 1.3 6.5-5.9-3.3-5.9 3.3 1.3-6.5-4.9-4.5 6.6-.7z" fill="currentColor" />
        </svg>
      {%- endfor -%}
    </span>

    <span class="tpb__text">{{ section.settings.badge_text }}</span>
  </{{ tag }}>
</div>

{% stylesheet %}
  .tpb {
    display: flex;
    justify-content: center;
  }

  .tpb__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 999px;
    background: var(--tpb-bg);
    color: var(--tpb-text-color);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  a.tpb__badge:hover {
    transform: translateY(-2px);
  }

  .tpb__stars {
    display: flex;
    gap: 2px;
    color: var(--tpb-star-color);
    flex: none;
  }

  .tpb__text {
    font-size: 1rem;
    font-weight: 700;
    white-space: nowrap;
  }

  @media screen and (max-width: 480px) {
    .tpb__badge {
      padding: 12px 18px;
    }

    .tpb__text {
      font-size: 0.9rem;
      white-space: normal;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trustpilot Badge",
  "tag": "section",
  "class": "tpb-wrapper section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "Static badge, not a live Trustpilot feed -- keep the text matching your real Trustpilot profile so it stays honest, and link it to that profile."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Rated Excellent on Trustpilot"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link to Trustpilot profile"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#ffb800"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "alpha": true,
      "default": "#1a1a1acc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Trustpilot Badge"
    }
  ]
}
{% endschema %}
