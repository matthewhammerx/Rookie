{% comment %}
  Trustpilot Badge (Static)
  A compact, square trust badge styled after Trustpilot's "Mini"
  TrustBox widget shape. Static/manually-editable, not a live Trustpilot
  embed -- the rating, review count, and link are theme settings you
  control, so keep them matching your real Trustpilot profile.
{% endcomment %}

{%- liquid
  assign rating = section.settings.rating
  assign full_stars = rating | floor
  assign has_half_star = false
  assign remainder = rating | minus: full_stars
  if remainder >= 0.25 and remainder < 0.75
    assign has_half_star = true
  elsif remainder >= 0.75
    assign full_stars = full_stars | plus: 1
  endif
  assign empty_stars = 5 | minus: full_stars
  if has_half_star
    assign empty_stars = empty_stars | minus: 1
  endif
-%}

<div
  class="tpb color-{{ section.settings.color_scheme }}"
  style="
    --tpb-bg: {{ section.settings.background_color }};
    --tpb-border-color: {{ section.settings.border_color }};
    --tpb-text-color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- liquid
    assign tag = 'div'
    if section.settings.link_url != blank
      assign tag = 'a'
    endif
  -%}

  <{{ tag }}
    class="tpb__badge"
    {% if section.settings.link_url != blank %}
      href="{{ section.settings.link_url }}"
      target="_blank"
      rel="noopener noreferrer"
    {% endif %}
  >
    <div class="tpb__stars" aria-hidden="true">
      {%- for i in (1..full_stars) -%}
        <svg viewBox="0 0 24 24" width="18" height="18" class="tpb__star tpb__star--full">
          <rect width="24" height="24" rx="4" fill="currentColor" />
          <path d="M12 5.5l1.8 3.9 4.2.4-3.2 2.9.9 4.2-3.7-2.2-3.7 2.2.9-4.2-3.2-2.9 4.2-.4z" fill="#fff" />
        </svg>
      {%- endfor -%}
      {%- if has_half_star -%}
        <svg viewBox="0 0 24 24" width="18" height="18" class="tpb__star tpb__star--half">
          <rect width="24" height="24" rx="4" fill="currentColor" />
          <clipPath id="tpb-half-{{ section.id }}">
            <rect x="0" y="0" width="12" height="24" />
          </clipPath>
          <path d="M12 5.5l1.8 3.9 4.2.4-3.2 2.9.9 4.2-3.7-2.2-3.7 2.2.9-4.2-3.2-2.9 4.2-.4z" fill="#fff" clip-path="url(#tpb-half-{{ section.id }})" />
        </svg>
      {%- endif -%}
      {%- for i in (1..empty_stars) -%}
        <svg viewBox="0 0 24 24" width="18" height="18" class="tpb__star tpb__star--empty">
          <rect width="24" height="24" rx="4" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      {%- endfor -%}
    </div>

    <p class="tpb__rating">{{ rating }}<span class="tpb__rating-max">/5</span></p>

    {%- if section.settings.headline != blank -%}
      <p class="tpb__headline">{{ section.settings.headline }}</p>
    {%- endif -%}

    {%- if section.settings.review_count_text != blank -%}
      <p class="tpb__review-count">{{ section.settings.review_count_text }}</p>
    {%- endif -%}

    <div class="tpb__wordmark">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M12 2l2.6 5.9 6.4.6-4.8 4.3 1.4 6.2L12 15.9 6.4 19l1.4-6.2L3 8.5l6.4-.6z" fill="currentColor" />
      </svg>
      <span>Trustpilot</span>
    </div>
  </{{ tag }}>
</div>

{% stylesheet %}
  .tpb {
    display: flex;
    justify-content: center;
  }

  .tpb__badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 168px;
    padding: 20px 16px;
    border-radius: 16px;
    background: var(--tpb-bg);
    border: 1px solid var(--tpb-border-color);
    color: var(--tpb-text-color);
    text-decoration: none;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  a.tpb__badge:hover {
    transform: translateY(-2px);
    border-color: #ff2fb1;
  }

  .tpb__stars {
    display: flex;
    gap: 3px;
    color: #00b67a;
  }

  .tpb__star--empty {
    color: rgba(255, 255, 255, 0.25);
  }

  .tpb__rating {
    margin: 4px 0 0;
    font-size: 1.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .tpb__rating-max {
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.6;
  }

  .tpb__headline {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .tpb__review-count {
    margin: 0;
    font-size: 0.75rem;
    opacity: 0.65;
  }

  .tpb__wordmark {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 6px;
    padding-top: 10px;
    border-top: 1px solid var(--tpb-border-color);
    width: 100%;
    justify-content: center;
    color: #00b67a;
    font-size: 0.8rem;
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trustpilot Badge",
  "tag": "section",
  "class": "tpb-wrapper section-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "Static badge, not a live Trustpilot feed -- keep the rating/review count matching your real Trustpilot profile so it stays honest, and link it to that profile."
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Star rating",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Excellent"
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Review count text",
      "default": "Based on 1,234 reviews"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link to Trustpilot profile"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "alpha": true,
      "default": "#ffffff0d"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "alpha": true,
      "default": "#ffffff26"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Trustpilot Badge"
    }
  ]
}
{% endschema %}
