

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }}">
  <div
    class="spacing-style search-page__header search-page__header-{{ section.id }}"
    style="
      --horizontal-alignment: {{ section.settings.alignment }};
      --search-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
      --search-heading-size-desktop: {{ section.settings.heading_size }}px;
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% assign heading_text = 'content.search' | t %}

    {% if search.performed %}
      {% assign heading_text = 'content.search_results' | t %}
    {% endif %}

    {% capture heading_text %}
      <h3>{{ heading_text }}</h3>
    {% endcapture %}

    {% content_for 'block', id: 'heading', type: '_heading', text: heading_text %}
    {% content_for 'block', id: 'search', type: '_search-input' %}
  </div>
</div>

<style>
  .search-page__header-{{ section.id }} h3 {
    font-size: var(--search-heading-size-mobile);
  }

  @media screen and (min-width: 750px) {
    .search-page__header-{{ section.id }} h3 {
      font-size: var(--search-heading-size-desktop);
    }
  }

  .search-page__header-{{ section.id }} search-page-input-component {
    background: linear-gradient(165deg, rgba(40, 20, 34, 0.85), rgba(20, 10, 18, 0.75));
    border: 1px solid rgba(235, 0, 202, 0.4);
    border-radius: 999px;
    box-shadow: 0 0 24px -6px rgba(235, 0, 202, 0.5);
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .search-page__header-{{ section.id }} search-page-input-component:focus-within {
    border-color: rgba(235, 0, 202, 0.85);
    box-shadow: 0 0 28px -4px rgba(235, 0, 202, 0.75);
  }

  .search-page__header-{{ section.id }} .search-page-input {
    background: transparent;
    border: none;
    border-radius: 999px;
    color: #ffffff;
  }

  .search-page__header-{{ section.id }} .search-page-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .search-page__header-{{ section.id }} .search__icon svg {
    color: #eb00ca;
  }

  .search-page__header-{{ section.id }} .search__reset-button {
    color: #eb00ca;
  }

  .search-page__header-{{ section.id }} .search__reset-button:hover {
    color: #ffffff;
  }
</style>

{% schema %}
{
  "name": "t:names.search",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Heading size"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 20,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
